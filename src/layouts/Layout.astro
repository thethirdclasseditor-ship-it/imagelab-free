---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schemas?: Record<string, unknown>[];
}

const { title, description, schemas = [] } = Astro.props;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Search Console HTML Meta Tag ঠিক এই লাইনের নিচে বসাবে -->

    <!-- Social Share / Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col antialiased">
    <!-- Top Navbar -->
    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur border-b border-slate-200">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between gap-2">
        <a href="/" class="flex items-center gap-2 font-bold text-lg text-slate-900 shrink-0">
          <span class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-sm font-extrabold">
            IL
          </span>
          <span>ImageLab</span>
        </a>

        <nav class="flex items-center gap-2 sm:gap-3 text-xs sm:text-sm">
          <a
            href="/remove-background"
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-purple-600 hover:bg-purple-700 text-white font-semibold transition"
          >
            ✨ AI BG Remover
          </a>
          <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-medium border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            100% Private
          </span>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-white mt-16">
      <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
        <p>© {new Date().getFullYear()} ImageLab. 100% Free & Local Browser Processing.</p>
        <div class="flex items-center gap-4 text-xs">
          <a href="/remove-background" class="hover:text-blue-600">AI BG Remover</a>
          <a href="/compress-image-to-50kb" class="hover:text-blue-600">50KB Compressor</a>
          <a href="/resize-photo-300x300" class="hover:text-blue-600">300×300 Photo</a>
        </div>
      </div>
    </footer>
  </body>
</html>
