---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, schemas = [], noindex = false } = Astro.props;
const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site).toString()
  : Astro.url.href;

const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ImageLab',
    url: siteBase,
    logo: `${siteBase}/logo.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ImageLab',
    url: siteBase,
  },
];

const allSchemas = [...baseSchemas, ...schemas];

const navMenus = [
  {
    label: 'Studio',
    items: [
      { name: 'AI Background Remover', desc: 'On-device HD cutouts', href: '/remove-background' },
      { name: 'AI Photo Enhancer', desc: 'Neural super-resolution & clarity', href: '/photo-enhancer' },
      { name: 'Crop & Rotate', desc: 'Visual framing & aspect ratios', href: '/crop-image' },
      { name: 'Privacy Blur & Redact', desc: 'Pixelate or blackout faces & IDs', href: '/blur-image' },
      { name: 'EXIF Metadata Remover', desc: 'Inspect & wipe GPS/camera tags', href: '/exif-remover' },
      { name: 'Batch Watermark', desc: 'Text, logos & tiled stamps', href: '/watermark-image' },
      { name: 'Image to PDF', desc: 'Merge photos into clean A4 PDFs', href: '/image-to-pdf' },
    ],
  },
  {
    label: 'Optimize',
    items: [
      { name: 'HEIC to JPG', desc: 'iPhone photos to standard JPG', href: '/heic-to-jpg' },
      { name: 'AVIF to JPG', desc: 'Web AVIF to universal JPG', href: '/avif-to-jpg' },
      { name: 'JPG to WEBP', desc: 'Faster website images', href: '/jpg-to-webp' },
      { name: 'WEBP to JPG', desc: 'Universal photo compatibility', href: '/webp-to-jpg' },
      { name: 'Image Compressor', desc: 'MozJPEG, LibWebP & UPNG', href: '/image-compressor' },
      { name: 'Compress to 50KB', desc: 'Auto-fit portal upload limits', href: '/compress-image-to-50kb' },
      { name: 'Compress to 100KB', desc: 'Balanced web & portal size', href: '/compress-image-to-100kb' },
    ],
  },
  {
    label: 'Presets',
    items: [
      { name: '300×300 Photo', desc: 'Portrait crop under 100KB', href: '/resize-photo-300x300' },
      { name: '300×80 Signature', desc: 'Clean padding under 60KB', href: '/resize-signature-300x80' },
      { name: 'Passport 600×600', desc: 'Digital 2×2 inch standard', href: '/passport-photo-resizer' },
      { name: 'YouTube 1280×720', desc: 'Crisp 16:9 HD thumbnails', href: '/youtube-thumbnail-resizer' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalUrl} />}

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('imagelab-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteBase}/logo.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={`${siteBase}/logo.png`} />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="studio-canvas min-h-screen flex flex-col text-zinc-950 transition-colors duration-200">
    <!-- Minimalist Frosted Navbar -->
    <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-xl border-b border-zinc-200/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <img
            src="/logo.png"
            alt="ImageLab Logo"
            width="36"
            height="36"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-[10px] object-cover bg-black ring-1 ring-black/10 dark:ring-white/15 shadow-xs group-hover:scale-105 transition-transform"
          />
          <span class="font-bold text-[17px] tracking-tight text-zinc-950">ImageLab</span>
        </a>

        <nav aria-label="Main navigation" class="hidden md:flex items-center gap-1">
          {navMenus.map((menu) => (
            <div class="relative group nav-dropdown">
              <button
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                class="nav-dropdown-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-[13.5px] font-medium text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100 transition cursor-pointer"
              >
                <span>{menu.label}</span>
                <svg class="w-3.5 h-3.5 opacity-50 group-hover:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>

              <div class="nav-dropdown-panel invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute left-0 top-full pt-2 w-72 z-50">
                <div class="studio-card rounded-2xl p-1.5 space-y-0.5">
                  {menu.items.map((item) => (
                    <a
                      href={item.href}
                      class="block px-3 py-2.5 rounded-xl hover:bg-zinc-100 transition group/item"
                    >
                      <div class="text-[13px] font-semibold text-zinc-900 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition">
                        {item.name}
                      </div>
                      <div class="text-[11.5px] text-zinc-500 mt-0.5">{item.desc}</div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/remove-background"
            class="btn-studio-primary inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-[13px] font-semibold"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
            </svg>
            <span class="hidden sm:inline">Remove BG</span>
            <span class="sm:hidden">AI BG</span>
          </a>

          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="Toggle theme"
            class="w-9 h-9 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 flex items-center justify-center transition active:scale-95 cursor-pointer"
          >
            <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
            <svg class="w-4 h-4 hidden dark:block text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          </button>

          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            class="md:hidden w-9 h-9 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 flex items-center justify-center transition cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-drawer" class="hidden md:hidden border-t border-zinc-200 bg-white px-4 py-4 space-y-5 max-h-[75vh] overflow-y-auto shadow-xl">
        {navMenus.map((menu) => (
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-2 px-1">
              {menu.label}
            </p>
            <div class="grid grid-cols-2 gap-1.5">
              {menu.items.map((item) => (
                <a
                  href={item.href}
                  class="px-3 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs font-semibold text-zinc-800 hover:border-blue-500 transition"
                >
                  {item.name}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Minimalist Footer -->
    <footer class="border-t border-zinc-200/80 bg-white/70 dark:bg-[#0c0c0f] backdrop-blur-sm mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-8 text-sm">
          <div class="space-y-2.5">
            <div class="flex items-center gap-2 font-bold text-zinc-950">
              <img
                src="/logo.png"
                alt="ImageLab Logo"
                width="26"
                height="26"
                class="w-6 h-6 rounded-lg object-cover bg-black ring-1 ring-black/10 dark:ring-white/15"
              />
              <span>ImageLab</span>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed max-w-[220px]">
              Browser-native image & PDF studio powered by WebAssembly. Zero uploads.
            </p>
          </div>

          <div>
            <p class="font-semibold text-zinc-900 text-xs mb-3">Studio</p>
            <ul class="space-y-2 text-xs text-zinc-500">
              <li><a href="/remove-background" class="hover:text-zinc-950 dark:hover:text-white transition">AI Background Remover</a></li>
              <li><a href="/photo-enhancer" class="hover:text-zinc-950 dark:hover:text-white transition">AI Photo Enhancer</a></li>
              <li><a href="/crop-image" class="hover:text-zinc-950 dark:hover:text-white transition">Crop & Rotate</a></li>
              <li><a href="/blur-image" class="hover:text-zinc-950 dark:hover:text-white transition">Privacy Blur & Redact</a></li>
              <li><a href="/exif-remover" class="hover:text-zinc-950 dark:hover:text-white transition">EXIF Metadata Remover</a></li>
              <li><a href="/watermark-image" class="hover:text-zinc-950 dark:hover:text-white transition">Batch Watermark</a></li>
              <li><a href="/image-to-pdf" class="hover:text-zinc-950 dark:hover:text-white transition">Image to PDF</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-zinc-900 text-xs mb-3">Optimize</p>
            <ul class="space-y-2 text-xs text-zinc-500">
              <li><a href="/heic-to-jpg" class="hover:text-zinc-950 dark:hover:text-white transition">HEIC to JPG</a></li>
              <li><a href="/avif-to-jpg" class="hover:text-zinc-950 dark:hover:text-white transition">AVIF to JPG</a></li>
              <li><a href="/jpg-to-webp" class="hover:text-zinc-950 dark:hover:text-white transition">JPG to WEBP</a></li>
              <li><a href="/webp-to-jpg" class="hover:text-zinc-950 dark:hover:text-white transition">WEBP to JPG</a></li>
              <li><a href="/compress-image-to-50kb" class="hover:text-zinc-950 dark:hover:text-white transition">Compress to 50KB</a></li>
              <li><a href="/compress-image-to-100kb" class="hover:text-zinc-950 dark:hover:text-white transition">Compress to 100KB</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-zinc-900 text-xs mb-3">Presets</p>
            <ul class="space-y-2 text-xs text-zinc-500">
              <li><a href="/resize-photo-300x300" class="hover:text-zinc-950 dark:hover:text-white transition">300×300 Photo</a></li>
              <li><a href="/resize-signature-300x80" class="hover:text-zinc-950 dark:hover:text-white transition">300×80 Signature</a></li>
              <li><a href="/passport-photo-resizer" class="hover:text-zinc-950 dark:hover:text-white transition">Passport 600×600</a></li>
              <li><a href="/youtube-thumbnail-resizer" class="hover:text-zinc-950 dark:hover:text-white transition">YouTube 1280×720</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-200/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-500">
          <span>© {new Date().getFullYear()} ImageLab</span>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/about" class="hover:text-zinc-950 dark:hover:text-white transition">About</a>
            <a href="/privacy" class="hover:text-zinc-950 dark:hover:text-white transition">Privacy</a>
            <a href="/terms" class="hover:text-zinc-950 dark:hover:text-white transition">Terms</a>
            <a href="/contact" class="hover:text-zinc-950 dark:hover:text-white transition">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const themeBtn = document.getElementById('theme-toggle-btn');
        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            const isDark = document.documentElement.classList.toggle('dark');
            try {
              localStorage.setItem('imagelab-theme', isDark ? 'dark' : 'light');
            } catch (e) {}
          });
        }

        const menuBtn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-drawer');
        if (menuBtn && drawer) {
          menuBtn.addEventListener('click', function () {
            const willOpen = drawer.classList.contains('hidden');
            drawer.classList.toggle('hidden');
            menuBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
          });
        }

        document.querySelectorAll('.nav-dropdown').forEach(function (wrap) {
          const btn = wrap.querySelector('.nav-dropdown-btn');
          if (!btn) return;
          wrap.addEventListener('mouseenter', function () {
            btn.setAttribute('aria-expanded', 'true');
          });
          wrap.addEventListener('mouseleave', function () {
            btn.setAttribute('aria-expanded', 'false');
          });
          wrap.addEventListener('focusin', function () {
            btn.setAttribute('aria-expanded', 'true');
          });
          wrap.addEventListener('focusout', function (e) {
            if (!wrap.contains(e.relatedTarget)) {
              btn.setAttribute('aria-expanded', 'false');
            }
          });
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            if (drawer && !drawer.classList.contains('hidden')) {
              drawer.classList.add('hidden');
              if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
            }
            if (document.activeElement && document.activeElement.closest('.nav-dropdown')) {
              document.activeElement.blur();
            }
          }
        });
      })();
    </script>
  </body>
</html>
