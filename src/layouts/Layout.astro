---
import { Icon } from 'astro-icon/components';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, schemas = [], noindex = false } = Astro.props;
const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site).toString()
  : Astro.url.href;

const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ImageLab',
    url: siteBase,
    logo: `${siteBase}/logo.png?v=2`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ImageLab',
    url: siteBase,
  },
];

const allSchemas = [...baseSchemas, ...schemas];

interface NavItem {
  name: string;
  desc: string;
  href: string;
  icon: string;
  soon?: boolean;
}

const navMenus: { label: string; items: NavItem[] }[] = [
  {
    label: 'Studio',
    items: [
      { name: 'Image to Text (OCR)', desc: 'Extract English & বাংলা text', href: '/image-to-text', icon: 'lucide:scan-text' },
      { name: 'Crop & Rotate', desc: 'Visual framing & aspect ratios', href: '/crop-image', icon: 'lucide:crop' },
      { name: 'Privacy Blur & Redact', desc: 'Pixelate or blackout faces & IDs', href: '/blur-image', icon: 'lucide:eye-off' },
      { name: 'EXIF Metadata Remover', desc: 'Inspect & wipe GPS/camera tags', href: '/exif-remover', icon: 'lucide:shield-check' },
      { name: 'Batch Watermark', desc: 'Text, logos & tiled stamps', href: '/watermark-image', icon: 'lucide:stamp' },
      { name: 'AI Background Remover', desc: 'Upgrading to instant HD cutouts', href: '/remove-background', icon: 'lucide:sparkles', soon: true },
      { name: 'AI Photo Enhancer', desc: 'Upgrading to HD restoration', href: '/photo-enhancer', icon: 'lucide:sliders-horizontal', soon: true },
    ],
  },
  {
    label: 'PDF Tools',
    items: [
      { name: 'Sign PDF', desc: 'Draw, type or upload signature & date', href: '/sign-pdf', icon: 'lucide:pen-tool' },
      { name: 'Organize & Rotate PDF', desc: 'Reorder, rotate, delete & watermark', href: '/organize-pdf', icon: 'lucide:layout-grid' },
      { name: 'Merge PDF', desc: 'Combine multiple PDFs losslessly', href: '/merge-pdf', icon: 'lucide:layers' },
      { name: 'Split & Extract PDF', desc: 'Extract ranges or separate pages', href: '/split-pdf', icon: 'lucide:scissors' },
      { name: 'Compress PDF', desc: 'Shrink scanned & photo PDFs', href: '/compress-pdf', icon: 'lucide:minimize-2' },
      { name: 'PDF to JPG', desc: 'Render PDF pages to HD images', href: '/pdf-to-jpg', icon: 'lucide:image' },
      { name: 'Image to PDF', desc: 'Merge up to 30 photos into A4 PDF', href: '/image-to-pdf', icon: 'lucide:file-text' },
    ],
  },
  {
    label: 'Graphics',
    items: [
      { name: 'QR Code Generator', desc: 'Static SVG/PNG with logo · never expires', href: '/qr-code-generator', icon: 'lucide:qr-code' },
      { name: 'Barcode Generator', desc: 'EAN-13, UPC-A, Code 128 & bulk ZIP', href: '/barcode-generator', icon: 'lucide:barcode' },
      { name: 'SVG to PNG', desc: 'Render vector SVGs up to 4096px HD', href: '/svg-to-png', icon: 'lucide:file-code-2' },
      { name: 'Favicon Generator', desc: 'Multi-size .ICO, Apple & PWA icon pack', href: '/favicon-generator', icon: 'lucide:globe' },
      { name: 'Color Palette Picker', desc: 'Extract HEX/RGB/HSL & CSS from photos', href: '/color-picker', icon: 'lucide:palette' },
    ],
  },
  {
    label: 'Optimize',
    items: [
      { name: 'HEIC to JPG', desc: 'iPhone photos to standard JPG', href: '/heic-to-jpg', icon: 'lucide:smartphone' },
      { name: 'AVIF to JPG', desc: 'Web AVIF to universal JPG', href: '/avif-to-jpg', icon: 'lucide:globe' },
      { name: 'JPG to WEBP', desc: 'Faster website images', href: '/jpg-to-webp', icon: 'lucide:zap' },
      { name: 'WEBP to JPG', desc: 'Universal photo compatibility', href: '/webp-to-jpg', icon: 'lucide:refresh-cw' },
      { name: 'Image Compressor', desc: 'Shrink photos up to 80% smaller', href: '/image-compressor', icon: 'lucide:minimize-2' },
      { name: 'Compress to 50KB', desc: 'Auto-fit portal upload limits', href: '/compress-image-to-50kb', icon: 'lucide:gauge' },
      { name: 'Compress to 100KB', desc: 'Balanced web & portal size', href: '/compress-image-to-100kb', icon: 'lucide:gauge' },
    ],
  },
  {
    label: 'Presets',
    items: [
      { name: '300×300 Photo', desc: 'Portrait crop under 100KB', href: '/resize-photo-300x300', icon: 'lucide:user' },
      { name: '300×80 Signature', desc: 'Clean padding under 60KB', href: '/resize-signature-300x80', icon: 'lucide:pen-tool' },
      { name: 'Passport 600×600', desc: 'Digital 2×2 inch standard', href: '/passport-photo-resizer', icon: 'lucide:user-check' },
      { name: 'YouTube 1280×720', desc: 'Crisp 16:9 HD thumbnails', href: '/youtube-thumbnail-resizer', icon: 'lucide:monitor' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalUrl} />}

    <link rel="icon" type="image/png" href="/logo.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="/logo.png?v=2" />
    <link rel="apple-touch-icon" href="/logo.png?v=2" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ImageLab" />

    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('imagelab-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteBase}/logo.png?v=2`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={`${siteBase}/logo.png?v=2`} />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="studio-canvas min-h-screen flex flex-col text-zinc-950 transition-colors duration-200">
    <!-- Minimalist Frosted Navbar -->
    <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-xl border-b border-zinc-200/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2 group shrink-0">
          <img
            src="/logo.png?v=2"
            alt="ImageLab Logo"
            width="38"
            height="38"
            class="w-9 h-9 sm:w-10 sm:h-10 object-contain dark:invert group-hover:scale-105 transition-transform"
          />
          <span class="font-bold text-[18px] tracking-tight text-zinc-950">ImageLab</span>
        </a>

        <nav aria-label="Main navigation" class="hidden md:flex items-center gap-0.5 lg:gap-1">
          {navMenus.map((menu) => (
            <div class="relative group nav-dropdown">
              <button
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                class="nav-dropdown-btn inline-flex items-center gap-1 px-2.5 lg:px-3 py-2 rounded-xl text-[13px] lg:text-[13.5px] font-medium text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100 transition cursor-pointer"
              >
                <span>{menu.label}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-3.5 h-3.5 opacity-55 group-hover:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </button>

              <div class="nav-dropdown-panel invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute left-0 top-full pt-2 w-80 z-50">
                <div class="studio-card rounded-2xl p-1.5 space-y-0.5">
                  {menu.items.map((item) => (
                    <a
                      href={item.href}
                      class={`flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-zinc-100 transition group/item ${
                        item.soon ? 'opacity-75' : ''
                      }`}
                    >
                      <span class="w-8 h-8 rounded-lg bg-zinc-100 border border-zinc-200/80 text-zinc-600 group-hover/item:bg-blue-600 group-hover/item:text-white group-hover/item:border-blue-600 flex items-center justify-center shrink-0 mt-0.5 transition-colors">
                        <Icon name={item.icon} class="w-4 h-4" aria-hidden="true" />
                      </span>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-[13px] font-semibold text-zinc-900 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition truncate">
                            {item.name}
                          </span>
                          {item.soon && (
                            <span class="px-1.5 py-0.5 rounded-md bg-amber-500/15 text-amber-700 dark:text-amber-300 text-[10px] font-bold uppercase tracking-wide shrink-0">
                              Soon
                            </span>
                          )}
                        </div>
                        <div class="text-[11.5px] text-zinc-500 mt-0.5 truncate">{item.desc}</div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))}

          <a
            href="/guides"
            class="px-2.5 lg:px-3 py-2 rounded-xl text-[13px] lg:text-[13.5px] font-medium text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100 transition"
          >
            Guides
          </a>
        </nav>

        <div class="flex items-center gap-2 shrink-0">
          <a
            href="/image-to-text"
            class="btn-studio-primary inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-[13px] font-semibold"
          >
            <Icon name="lucide:scan-text" class="w-3.5 h-3.5" aria-hidden="true" />
            <span class="hidden sm:inline">Image to Text</span>
            <span class="sm:hidden">AI OCR</span>
          </a>

          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="Toggle theme"
            class="w-9 h-9 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 flex items-center justify-center transition active:scale-95 cursor-pointer"
          >
            <Icon name="lucide:moon" class="w-4 h-4 block dark:hidden" aria-hidden="true" />
            <Icon name="lucide:sun" class="w-4 h-4 hidden dark:block text-amber-300" aria-hidden="true" />
          </button>

          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            class="md:hidden w-9 h-9 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 flex items-center justify-center transition cursor-pointer"
          >
            <Icon name="lucide:menu" class="w-4 h-4" aria-hidden="true" />
          </button>
        </div>
      </div>

      <div id="mobile-drawer" class="hidden md:hidden border-t border-zinc-200 bg-white px-4 py-4 space-y-5 max-h-[75vh] overflow-y-auto shadow-xl">
        {navMenus.map((menu) => (
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-2 px-1">
              {menu.label}
            </p>
            <div class="grid grid-cols-2 gap-1.5">
              {menu.items.map((item) => (
                <a
                  href={item.href}
                  class={`px-3 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs font-semibold text-zinc-800 hover:border-blue-500 transition flex items-center gap-2 ${
                    item.soon ? 'opacity-70' : ''
                  }`}
                >
                  <Icon name={item.icon} class="w-3.5 h-3.5 text-zinc-500 shrink-0" aria-hidden="true" />
                  <span class="truncate flex-1">{item.name}</span>
                  {item.soon && (
                    <span class="px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-700 dark:text-amber-300 text-[9px] font-bold uppercase shrink-0">
                      Soon
                    </span>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
        <div>
          <a
            href="/guides"
            class="flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs font-semibold text-zinc-800 hover:border-blue-500 transition"
          >
            <Icon name="lucide:book-open" class="w-3.5 h-3.5 text-zinc-500" aria-hidden="true" />
            <span>Image &amp; PDF Guides</span>
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Minimalist Footer -->
    <footer class="border-t border-zinc-200/80 bg-white/70 dark:bg-[#0c0c0f] backdrop-blur-sm mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
        <div class="grid sm:grid-cols-2 md:grid-cols-5 gap-8 text-sm">
          <div class="space-y-2.5">
            <div class="flex items-center gap-2 font-bold text-zinc-950">
              <img
                src="/logo.png?v=2"
                alt="ImageLab Logo"
                width="28"
                height="28"
                class="w-7 h-7 object-contain dark:invert"
              />
              <span>ImageLab</span>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed max-w-[210px]">
              Fast, private image, PDF &amp; graphic tools right in your browser.
            </p>
          </div>

          <div>
            <p class="font-semibold text-zinc-900 text-xs mb-3">Graphics</p>
            <ul class="space-y-2 text-xs text-zinc-500">
              <li><a href="/qr-code-generator" class="hover:text-zinc-950 dark:hover:text-white transition">QR Code Generator</a></li>
              <li><a href="/barcode-generator" class="hover:text-zinc-950 dark:hover:text-white transition">Barcode Generator</a></li>
              <li><a href="/svg-to-png" class="hover:text-zinc-950 dark:hover:text-white transition">SVG to PNG</a></li>
              <li><a href="/favicon-generator" class="hover:text-zinc-950 dark:hover:text-white transition">Favicon Generator</a></li>
              <li><a href="/color-picker" class="hover:text-zinc-950 dark:hover:text-white transition">Color Palette Picker</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-zinc-900 text-xs mb-3">Image Studio</p>
            <ul class="space-y-2 text-xs text-zinc-500">
              <li><a href="/image-to-text" class="hover:text-zinc-950 dark:hover:text-white transition">Image to Text (OCR)</a></li>
              <li><a href="/crop-image" class="hover:text-zinc-950 dark:hover:text-white transition">Crop &amp; Rotate</a></li>
              <li><a href="/blur-image" class="hover:text-zinc-950 dark:hover:text-white transition">Privacy Blur &amp; Redact</a></li>
              <li><a href="/exif-remover" class="hover:text-zinc-950 dark:hover:text-white transition">EXIF Metadata Remover</a></li>
              <li><a href="/watermark-image" class="hover:text-zinc-950 dark:hover:text-white transition">Batch Watermark</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-zinc-900 text-xs mb-3">PDF Suite</p>
            <ul class="space-y-2 text-xs text-zinc-500">
              <li><a href="/sign-pdf" class="hover:text-zinc-950 dark:hover:text-white transition">Sign PDF</a></li>
              <li><a href="/organize-pdf" class="hover:text-zinc-950 dark:hover:text-white transition">Organize &amp; Rotate PDF</a></li>
              <li><a href="/merge-pdf" class="hover:text-zinc-950 dark:hover:text-white transition">Merge PDF</a></li>
              <li><a href="/split-pdf" class="hover:text-zinc-950 dark:hover:text-white transition">Split &amp; Extract PDF</a></li>
              <li><a href="/compress-pdf" class="hover:text-zinc-950 dark:hover:text-white transition">Compress PDF</a></li>
              <li><a href="/pdf-to-jpg" class="hover:text-zinc-950 dark:hover:text-white transition">PDF to JPG</a></li>
              <li><a href="/image-to-pdf" class="hover:text-zinc-950 dark:hover:text-white transition">Image to PDF</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-zinc-900 text-xs mb-3">Popular</p>
            <ul class="space-y-2 text-xs text-zinc-500">
              <li><a href="/heic-to-jpg" class="hover:text-zinc-950 dark:hover:text-white transition">HEIC to JPG</a></li>
              <li><a href="/jpg-to-webp" class="hover:text-zinc-950 dark:hover:text-white transition">JPG to WEBP</a></li>
              <li><a href="/compress-image-to-50kb" class="hover:text-zinc-950 dark:hover:text-white transition">Compress to 50KB</a></li>
              <li><a href="/resize-photo-300x300" class="hover:text-zinc-950 dark:hover:text-white transition">300×300 Photo</a></li>
              <li><a href="/resize-signature-300x80" class="hover:text-zinc-950 dark:hover:text-white transition">300×80 Signature</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-200/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-500">
          <span>© {new Date().getFullYear()} ImageLab</span>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/guides" class="hover:text-zinc-950 dark:hover:text-white transition">Guides</a>
            <a href="/about" class="hover:text-zinc-950 dark:hover:text-white transition">About</a>
            <a href="/privacy" class="hover:text-zinc-950 dark:hover:text-white transition">Privacy</a>
            <a href="/terms" class="hover:text-zinc-950 dark:hover:text-white transition">Terms</a>
            <a href="/contact" class="hover:text-zinc-950 dark:hover:text-white transition">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const themeBtn = document.getElementById('theme-toggle-btn');
        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            const isDark = document.documentElement.classList.toggle('dark');
            try {
              localStorage.setItem('imagelab-theme', isDark ? 'dark' : 'light');
            } catch (e) {}
          });
        }

        const menuBtn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-drawer');
        if (menuBtn && drawer) {
          menuBtn.addEventListener('click', function () {
            const willOpen = drawer.classList.contains('hidden');
            drawer.classList.toggle('hidden');
            menuBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
          });
        }

        document.querySelectorAll('.nav-dropdown').forEach(function (wrap) {
          const btn = wrap.querySelector('.nav-dropdown-btn');
          if (!btn) return;
          wrap.addEventListener('mouseenter', function () {
            btn.setAttribute('aria-expanded', 'true');
          });
          wrap.addEventListener('mouseleave', function () {
            btn.setAttribute('aria-expanded', 'false');
          });
          wrap.addEventListener('focusin', function () {
            btn.setAttribute('aria-expanded', 'true');
          });
          wrap.addEventListener('focusout', function (e) {
            if (!wrap.contains(e.relatedTarget)) {
              btn.setAttribute('aria-expanded', 'false');
            }
          });
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            if (drawer && !drawer.classList.contains('hidden')) {
              drawer.classList.add('hidden');
              if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
            }
            if (document.activeElement && document.activeElement.closest('.nav-dropdown')) {
              document.activeElement.blur();
            }
          }
        });

        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      })();
    </script>
  </body>
</html>
