---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schemas?: Record<string, unknown>[];
}

const { title, description, schemas = [] } = Astro.props;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site).toString()
  : Astro.url.href;

const navMenus = [
  {
    label: 'Image Tools',
    items: [
      { name: 'Crop & Rotate (Visual)', href: '/crop-image', badge: 'New' },
      { name: 'Studio Photo Enhancer', href: '/photo-enhancer', badge: 'Live' },
      { name: 'Free Image Compressor', href: '/image-compressor' },
      { name: 'Compress to 50KB', href: '/compress-image-to-50kb' },
      { name: 'Compress to 100KB', href: '/compress-image-to-100kb' },
      { name: 'Compress to 20KB', href: '/compress-image-to-20kb' },
    ],
  },
  {
    label: 'Converters',
    items: [
      { name: 'JPG to WEBP', href: '/jpg-to-webp' },
      { name: 'PNG to WEBP', href: '/png-to-webp' },
      { name: 'WEBP to JPG', href: '/webp-to-jpg' },
      { name: 'PNG to JPG', href: '/png-to-jpg' },
      { name: 'JPG to PNG', href: '/jpg-to-png' },
    ],
  },
  {
    label: 'Job & Presets',
    items: [
      { name: '300×300 Job Photo (<100KB)', href: '/resize-photo-300x300' },
      { name: '300×80 Signature (<60KB)', href: '/resize-signature-300x80' },
      { name: 'Passport Photo (600×600)', href: '/passport-photo-resizer' },
      { name: 'YouTube Thumbnail (1280×720)', href: '/youtube-thumbnail-resizer' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Search Console Verification Tag এখানে বসাবে -->

    <!-- Anti-flash Dark Mode initializer -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('imagelab-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col antialiased transition-colors duration-200">
    <!-- Pro Sticky Header -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-2 font-extrabold text-lg text-slate-900 shrink-0">
          <span class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center text-sm font-black shadow-xs">
            IL
          </span>
          <span>ImageLab</span>
        </a>

        <!-- Desktop Dropdown Navigation (11zon-style) -->
        <nav aria-label="Main navigation" class="hidden md:flex items-center gap-1">
          {navMenus.map((menu) => (
            <div class="relative group">
              <button
                type="button"
                class="inline-flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-semibold text-slate-700 hover:text-blue-600 hover:bg-slate-100 transition cursor-pointer"
              >
                <span>{menu.label}</span>
                <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>

              <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full pt-1.5 w-64 z-50">
                <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-2 space-y-0.5">
                  {menu.items.map((item) => (
                    <a
                      href={item.href}
                      class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition"
                    >
                      <span>{item.name}</span>
                      {item.badge && (
                        <span class="px-1.5 py-0.5 rounded bg-blue-600 text-white text-[10px] font-bold">
                          {item.badge}
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </nav>

        <!-- Right Controls: AI BG Remover + Theme Toggle + Mobile Menu -->
        <div class="flex items-center gap-2">
          <a
            href="/remove-background"
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs sm:text-sm font-semibold shadow-xs transition"
          >
            <span>✨</span>
            <span class="hidden sm:inline">AI BG Remover</span>
            <span class="sm:hidden">AI BG</span>
          </a>

          <!-- Dark / Light Toggle -->
          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="Toggle dark mode"
            title="Switch Dark / Light mode"
            class="p-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 transition cursor-pointer"
          >
            <!-- Moon Icon (shown in light mode) -->
            <svg id="icon-moon" class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="icon-sun" class="w-4 h-4 hidden dark:block text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          </button>

          <!-- Mobile Drawer Button -->
          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Open tools menu"
            aria-expanded="false"
            class="md:hidden p-2 rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-100 cursor-pointer"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Drawer -->
      <div id="mobile-drawer" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-4 space-y-4 max-h-[75vh] overflow-y-auto shadow-lg">
        {navMenus.map((menu) => (
          <div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">
              {menu.label}
            </p>
            <div class="grid grid-cols-2 gap-1.5">
              {menu.items.map((item) => (
                <a
                  href={item.href}
                  class="px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600"
                >
                  {item.name}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Rich SEO Footer -->
    <footer class="border-t border-slate-200 bg-white mt-16">
      <div class="max-w-6xl mx-auto px-4 py-10 grid sm:grid-cols-2 md:grid-cols-4 gap-8 text-sm">
        <div class="space-y-2">
          <div class="flex items-center gap-2 font-extrabold text-slate-900">
            <span class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs font-black">IL</span>
            <span>ImageLab</span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            100% browser-based image studio powered by WebAssembly (MozJPEG, LibWebP, UPNG). Zero server uploads.
          </p>
        </div>

        <div>
          <p class="font-bold text-slate-900 text-xs uppercase tracking-wider mb-3">Visual Studio</p>
          <ul class="space-y-2 text-xs text-slate-600">
            <li><a href="/crop-image" class="hover:text-blue-600">Visual Crop & Rotate</a></li>
            <li><a href="/photo-enhancer" class="hover:text-blue-600">Live Studio Enhancer</a></li>
            <li><a href="/remove-background" class="hover:text-blue-600">AI Background Remover</a></li>
          </ul>
        </div>

        <div>
          <p class="font-bold text-slate-900 text-xs uppercase tracking-wider mb-3">Compress & Convert</p>
          <ul class="space-y-2 text-xs text-slate-600">
            <li><a href="/jpg-to-webp" class="hover:text-blue-600">JPG to WEBP</a></li>
            <li><a href="/compress-image-to-50kb" class="hover:text-blue-600">Compress to 50KB</a></li>
            <li><a href="/compress-image-to-100kb" class="hover:text-blue-600">Compress to 100KB</a></li>
          </ul>
        </div>

        <div>
          <p class="font-bold text-slate-900 text-xs uppercase tracking-wider mb-3">Job & Exam Presets</p>
          <ul class="space-y-2 text-xs text-slate-600">
            <li><a href="/resize-photo-300x300" class="hover:text-blue-600">300×300 Job Photo</a></li>
            <li><a href="/resize-signature-300x80" class="hover:text-blue-600">300×80 Signature</a></li>
            <li><a href="/passport-photo-resizer" class="hover:text-blue-600">Passport Photo (600×600)</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-slate-200 py-4 px-4 text-center text-xs text-slate-500">
        © {new Date().getFullYear()} ImageLab · Free Forever & 100% Private Local Processing.
      </div>
    </footer>

    <!-- Lightweight Vanilla JS for Theme & Mobile Drawer (Zero Hydration Cost) -->
    <script is:inline>
      (function () {
        const themeBtn = document.getElementById('theme-toggle-btn');
        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            const isDark = document.documentElement.classList.toggle('dark');
            try {
              localStorage.setItem('imagelab-theme', isDark ? 'dark' : 'light');
            } catch (e) {}
          });
        }

        const menuBtn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-drawer');
        if (menuBtn && drawer) {
          menuBtn.addEventListener('click', function () {
            const willOpen = drawer.classList.contains('hidden');
            drawer.classList.toggle('hidden');
            menuBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
          });
        }
      })();
    </script>
  </body>
</html>
