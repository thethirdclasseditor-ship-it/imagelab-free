---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PassportSheetTool from '../components/PassportSheetTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/passport-photo-sheet`;

const title = 'Passport Photo Print Sheet Maker (A4 & 4×6 Inch — 300 DPI) | ImageLabKit';
const description =
  'Create printable passport and stamp photo sheets on A4, 4×6 inch, 5×7, or Letter paper with exact 300 DPI dimensions and cutting guides. Supports Bangladesh (40×50mm), Visa (35×45mm), US 2×2 inch, and Stamp size.';

const faqs = [
  {
    q: 'How do I print the sheet at exact passport size without shrinking?',
    a: 'Export as PDF and in your printer dialog choose "Actual Size" or "Scale: 100%" (turn off "Fit to Page"). For photo lab printing on 4×6 inch glossy paper, export the 300 DPI JPG file.',
  },
  {
    q: 'Which photo sizes are supported?',
    a: 'Built-in presets include Bangladesh Passport (40×50 mm), International / EU / UK Visa (35×45 mm), US & India Square (2×2 inch / 50.8×50.8 mm), and Stamp Size (20×25 mm).',
  },
  {
    q: 'Is my portrait photo uploaded to any server?',
    a: 'Never. Framing, 300 DPI sheet generation, and PDF export all run 100% locally inside your browser.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLabKit Passport Photo Print Sheet Maker',
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Passport Photo Sheet', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Passport Photo Sheet</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Passport Photo Print Sheet
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Arrange multiple passport or stamp-size photos onto 4×6 inch or A4 sheets at true 300 DPI with cutting guides.
      </p>
    </header>

    <PassportSheetTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">True 300 DPI Print Scale</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Every millimeter is calculated at studio 300 DPI so printed copies match official passport and visa dimensions.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Built-In Zoom &amp; Cutting Guides</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Center your head and shoulders inside the frame, choose dashed or solid trim lines, and save paper with custom copy counts.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">4×6 Lab JPG &amp; A4 PDF</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Download a crisp JPG for any photo studio printer or an exact-dimension A4 PDF for instant home or office printing.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Related Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/passport-photo-resizer" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Passport 600×600</a>
          <a href="/resize-photo-300x300" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">300×300 Photo</a>
          <a href="/merge-images" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Merge Images (NID A4)</a>
          <a href="/crop-image" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Crop &amp; Rotate</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
