---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import BarcodeGeneratorTool from '../components/BarcodeGeneratorTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/barcode-generator`;

const title = 'Free Barcode Generator (EAN-13, UPC, Code 128) | ImageLab';
const description =
  'Generate print-ready Code 128, EAN-13, UPC-A, Code 39, and ITF-14 barcodes in HD PNG or Vector SVG. Supports bulk ZIP export of up to 100 SKUs locally in your browser.';

const faqs = [
  {
    q: 'Which barcode format should I choose for products vs internal inventory?',
    a: 'Use Code 128 for internal SKUs, warehouse labels, and shipping stickers—it supports letters, numbers, and dashes compactly. Use EAN-13 (international) or UPC-A (North America) for retail store packaging.',
  },
  {
    q: 'Can I generate barcodes in bulk for an entire product catalog?',
    a: 'Yes. Switch to Bulk Generator (ZIP), paste up to 100 SKUs or product numbers (one per line), and download all barcodes as crisp PNG or Vector SVG files inside a single ZIP archive.',
  },
  {
    q: 'Do I need to calculate the final check digit for EAN-13 or UPC-A?',
    a: 'No. If you type 12 digits for EAN-13 (or 11 digits for UPC-A), ImageLab automatically computes and appends the valid standard check digit.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free Barcode Generator',
  url: pageUrl,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Barcode Generator', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Barcode Generator</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Barcode Generator
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Create print-ready Code 128, EAN-13, UPC-A &amp; ITF-14 labels — single or bulk ZIP export.
      </p>
    </header>

    <BarcodeGeneratorTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Retail &amp; Logistics Standards</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Built-in validation and automatic check digits for Code 128, EAN-13, UPC-A, Code 39, and ITF-14.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Bulk 100-SKU ZIP Export</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Paste your entire SKU list to download print-ready SVG or HD PNG barcode labels in one click.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Crisp Vector &amp; High-DPI PNG</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Sharp pixel alignment ensures handheld laser and smartphone scanners read every label effortlessly.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More Graphics Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/qr-code-generator" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">QR Code Generator</a>
          <a href="/image-to-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Image to PDF</a>
          <a href="/watermark-image" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Batch Watermark</a>
          <a href="/crop-image" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Crop &amp; Rotate</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
