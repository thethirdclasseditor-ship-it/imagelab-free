---
import Layout from '../layouts/Layout.astro';
import WatermarkTool from '../components/WatermarkTool';
import { SEO_PAGES } from '../data/seoPages';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/watermark-image`;

const title = 'Add Watermark to Photos Online Free (Batch) | ImageLab';
const description =
  'Stamp custom text or transparent PNG logos onto up to 20 photos at once with live preview and tiled patterns. Free, zero server uploads, batch ZIP export.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Batch Photo Watermark Studio',
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};
---

<Layout title={title} description={description} schemas={[schema]}>
  <article class="max-w-5xl mx-auto px-4 pt-6 sm:pt-10 pb-10">
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500 mb-4 flex items-center gap-1.5">
      <a href="/" class="hover:text-blue-600 font-medium">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">Watermark Studio</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-7">
      <span class="inline-block px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold mb-3">
        Batch Text & Logo Watermark
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
        Free Online Photo Watermark Tool
      </h1>
      <p class="text-slate-600 mt-2.5 text-sm sm:text-base">
        Protect e-commerce product shots, portfolios, or NID photocopies with custom text, PNG logos, and tiled patterns—100% locally.
      </p>
    </header>

    <WatermarkTool client:load />

    <nav aria-label="More Tools" class="mt-12 border-t border-slate-200 pt-8">
      <h2 class="text-lg font-bold text-slate-900 mb-4">More Free Tools</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        {SEO_PAGES.slice(0, 8).map((item) => (
          <a
            href={`/${item.slug}`}
            class="px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs sm:text-sm font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 transition"
          >
            {item.shortName}
          </a>
        ))}
      </div>
    </nav>
  </article>
</Layout>
