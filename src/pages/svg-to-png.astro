---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SvgToPngTool from '../components/SvgToPngTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/svg-to-png`;

const title = 'SVG to PNG Converter Free Online (HD) | ImageLab';
const description =
  'Convert vector SVG logos and icons into sharp high-resolution PNG, WEBP, or JPG images up to 4096px wide locally in your browser. Batch ZIP export, zero uploads.';

const faqs = [
  {
    q: 'Can I scale a small 24×24 SVG icon up to 2048px without blur?',
    a: 'Yes. Because SVG is math-based vector artwork, ImageLab renders it natively at your exact target width (512px, 1024px, 2048px, or custom up to 4096px) with razor-sharp edges.',
  },
  {
    q: 'Does SVG to PNG preserve transparent backgrounds?',
    a: 'Yes. Transparent background is enabled by default for PNG and WEBP. Toggle it off anytime to fill behind your logo with a custom brand color.',
  },
  {
    q: 'Can I convert multiple SVG files at once?',
    a: 'Yes. Drop up to 20 SVG files in one batch and download all converted PNG, WEBP, or JPG files inside a single ZIP archive.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free SVG to PNG Converter',
  url: pageUrl,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'SVG to PNG', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">SVG to PNG</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        SVG to PNG Converter
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Render crisp vector SVG icons &amp; logos into high-resolution PNG, WEBP, or JPG locally.
      </p>
    </header>

    <SvgToPngTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Sharp Up to 4096px</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Pick exact pixel widths or 1×/2×/4× multipliers for retina displays, social banners, and app assets.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Transparent or Solid Fill</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Keep full alpha transparency in PNG/WEBP, or add a clean solid backdrop color in one click.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Batch 20 SVGs to ZIP</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Convert entire icon sets at once privately in your browser and download everything in one ZIP.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More Graphics Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/favicon-generator" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Favicon Generator</a>
          <a href="/color-picker" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Color Palette Picker</a>
          <a href="/qr-code-generator" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">QR Code Generator</a>
          <a href="/png-to-webp" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">PNG to WEBP</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
