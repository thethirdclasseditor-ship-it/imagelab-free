---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact ImageLab & Report Issues | ImageLab"
  description="Report bugs, suggest new free image or PDF tools, or ask privacy questions directly to the ImageLab team."
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 pb-14 space-y-8 animate-fade-up">
    <header>
      <p class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2">Support</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-950">
        Contact &amp; Feedback
      </h1>
      <p class="text-sm text-zinc-500 mt-2.5 leading-relaxed">
        Spotted a bug, have a feature request, or need help with a specific image or PDF format?
        We read every message.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 gap-4">
      <a
        href="https://github.com/thethirdclasseditor-ship-it/imagelab-free/issues/new"
        target="_blank"
        rel="noopener noreferrer"
        class="group studio-card rounded-3xl p-6 hover:border-blue-500/40 transition flex flex-col justify-between gap-4"
      >
        <div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 flex items-center justify-center transition-colors">
          <Icon name="lucide:file-text" class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <h2 class="text-base font-bold text-zinc-950 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
            Report a Bug or Request a Tool
          </h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Open an issue directly on our public GitHub repository with your browser version and steps to reproduce.
          </p>
        </div>
      </a>

      <div class="studio-card rounded-3xl p-6 flex flex-col justify-between gap-4">
        <div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center">
          <Icon name="lucide:shield-check" class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <h2 class="text-base font-bold text-zinc-950">Privacy &amp; Legal Inquiries</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Review how ImageLab handles local files and transient OCR on our{' '}
            <a href="/privacy" class="text-blue-600 font-semibold hover:underline">Privacy Policy</a>{' '}
            or submit a request via GitHub Issues.
          </p>
        </div>
      </div>
    </div>
  </article>
</Layout>
