---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact ImageLabKit — Support, Bug Reports & Feature Requests"
  description="Contact the ImageLabKit team to report a bug, request a new free image or PDF tool, or ask privacy and licensing questions."
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 pb-14 space-y-8 animate-fade-up">
    <header>
      <p class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2">Support</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-950">
        Contact &amp; Feedback
      </h1>
      <p class="text-sm text-zinc-500 mt-2.5 leading-relaxed">
        Spotted a bug, have a feature request, or need help with a specific image or PDF format?
        Send us a message directly below — we review every inquiry.
      </p>
    </header>

    <section class="studio-card rounded-3xl p-6 sm:p-8 space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-zinc-950">Send a Message or Bug Report</h2>
          <p class="text-xs text-zinc-500 mt-0.5">
            Fill in the details below to open a pre-formatted email or copy your message to send from any inbox.
          </p>
        </div>
        <span class="px-2.5 py-1 rounded-lg bg-emerald-500/12 text-emerald-700 dark:text-emerald-400 text-[11px] font-semibold">
          Typical reply: 24–48 hrs
        </span>
      </div>

      <form id="contact-composer" class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="c-topic" class="block text-xs font-semibold text-zinc-700">Topic</label>
            <select
              id="c-topic"
              class="w-full rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900 px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
            >
              <option value="Bug Report">Bug Report</option>
              <option value="Tool / Feature Request">Tool / Feature Request</option>
              <option value="Privacy & Legal Inquiry">Privacy &amp; Legal Inquiry</option>
              <option value="Business & General Inquiry">Business &amp; General Inquiry</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="c-tool" class="block text-xs font-semibold text-zinc-700">
              Related Tool (Optional)
            </label>
            <input
              id="c-tool"
              type="text"
              placeholder="e.g. Compress PDF, QR Generator, OCR..."
              class="w-full rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900 px-3.5 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="c-message" class="block text-xs font-semibold text-zinc-700">Message</label>
          <textarea
            id="c-message"
            rows="5"
            required
            placeholder="Describe your question, feature idea, or steps to reproduce an issue..."
            class="w-full rounded-2xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900 p-3.5 text-sm text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 resize-y"
          ></textarea>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
          <div class="flex flex-wrap items-center gap-2.5">
            <button
              type="submit"
              class="btn-studio-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold cursor-pointer"
            >
              <Icon name="lucide:mail" class="w-4 h-4" aria-hidden="true" />
              <span>Send via Email</span>
            </button>

            <button
              id="c-copy-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 hover:border-blue-500 text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-200 transition cursor-pointer"
            >
              <Icon name="lucide:copy" class="w-3.5 h-3.5" aria-hidden="true" />
              <span id="c-copy-label">Copy Message</span>
            </button>
          </div>

          <p id="c-status" class="text-xs font-medium text-emerald-600 dark:text-emerald-400 hidden"></p>
        </div>
      </form>
    </section>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="studio-card rounded-3xl p-6 flex flex-col justify-between gap-4">
        <div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center">
          <Icon name="lucide:mail" class="w-5 h-5" aria-hidden="true" />
        </div>
        <div class="space-y-1.5">
          <h2 class="text-base font-bold text-zinc-950">Direct Email Support</h2>
          <p class="text-xs text-zinc-500 leading-relaxed">
            Email us directly anytime at{' '}
            <a href="mailto:support@imagelabkit.com" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
              support@imagelabkit.com
            </a>.
          </p>
        </div>
      </div>

      <div class="studio-card rounded-3xl p-6 flex flex-col justify-between gap-4">
        <div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center">
          <Icon name="lucide:shield-check" class="w-5 h-5" aria-hidden="true" />
        </div>
        <div class="space-y-1.5">
          <h2 class="text-base font-bold text-zinc-950">Privacy &amp; Legal Inquiries</h2>
          <p class="text-xs text-zinc-500 leading-relaxed">
            Review how ImageLabKit handles local files and transient OCR in our{' '}
            <a href="/privacy" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">Privacy Policy</a>{' '}
            and{' '}
            <a href="/terms" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">Terms of Service</a>.
          </p>
        </div>
      </div>
    </div>
  </article>

  <script is:inline>
    (function () {
      const form = document.getElementById('contact-composer');
      const topicEl = document.getElementById('c-topic');
      const toolEl = document.getElementById('c-tool');
      const msgEl = document.getElementById('c-message');
      const copyBtn = document.getElementById('c-copy-btn');
      const copyLabel = document.getElementById('c-copy-label');
      const statusEl = document.getElementById('c-status');
      if (!form || !topicEl || !toolEl || !msgEl) return;

      function buildPayload() {
        const topic = topicEl.value || 'General Inquiry';
        const tool = (toolEl.value || '').trim();
        const message = (msgEl.value || '').trim();
        const subject = `[ImageLabKit] ${topic}${tool ? ` — ${tool}` : ''}`;
        const body = [
          `Topic: ${topic}`,
          tool ? `Tool: ${tool}` : null,
          `Page: ${window.location.origin}`,
          `Browser: ${navigator.userAgent}`,
          '',
          'Message:',
          message || '(Write your message here)',
        ].filter((l) => l !== null).join('\n');
        return { subject, body };
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const { subject, body } = buildPayload();
        window.location.href = `mailto:support@imagelabkit.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        if (statusEl) {
          statusEl.textContent = 'Opening your email app…';
          statusEl.classList.remove('hidden');
        }
      });

      if (copyBtn) {
        copyBtn.addEventListener('click', async function () {
          const { subject, body } = buildPayload();
          try {
            await navigator.clipboard.writeText(`To: support@imagelabkit.com\nSubject: ${subject}\n\n${body}`);
            if (copyLabel) copyLabel.textContent = 'Copied!';
            if (statusEl) {
              statusEl.textContent = 'Copied — paste into any email to support@imagelabkit.com';
              statusEl.classList.remove('hidden');
            }
            setTimeout(function () { if (copyLabel) copyLabel.textContent = 'Copy Message'; }, 2000);
          } catch (err) {}
        });
      }
    })();
  </script>
</Layout>
