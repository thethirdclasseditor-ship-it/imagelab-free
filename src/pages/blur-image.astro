---
import Layout from '../layouts/Layout.astro';
import PrivacyBlurTool from '../components/PrivacyBlurTool';
import { SEO_PAGES } from '../data/seoPages';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/blur-image`;

const title = 'Blur & Pixelate Image Online Free | ImageLabKit';
const description =
  'Hide faces, license plates, receipts, and sensitive ID numbers with pixelate, smooth blur, or solid blackout locally in your browser. Zero server uploads.';

const faqs = [
  {
    q: 'Which mode is safest for hiding ID numbers or passwords?',
    a: 'Solid Blackout permanently replaces pixels with solid black and cannot be reversed. High-strength Pixelate (mosaic) is also much harder to reconstruct than light Gaussian blur.',
  },
  {
    q: 'Does ImageLabKit also strip EXIF metadata from the redacted photo?',
    a: 'Yes. Because your redacted image is rendered to a fresh bitmap and encoded locally via MozJPEG, LibWebP, or UPNG, hidden GPS and EXIF headers are stripped automatically.',
  },
  {
    q: 'Are my unredacted private photos uploaded anywhere?',
    a: 'Never. All blurring, pixelating, and exporting run strictly inside your browser memory.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLabKit Privacy Blur & Redact Tool',
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Privacy Blur & Redact', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Privacy Blur &amp; Redact</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Privacy Blur &amp; Redact
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Pixelate, blur, or black out faces, license plates, and sensitive details before sharing.
      </p>
    </header>

    <PrivacyBlurTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Box &amp; Freehand Brush</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Draw crisp rectangles over documents and plates, or switch to the brush for organic face redaction.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">3 Security Styles</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Pick irreversible Solid Blackout for sensitive numbers, Mosaic Pixelate, or Smooth Blur—with unlimited Undo.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Zero Cloud Risk</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Never send unredacted IDs or personal photos to a remote server just to blur them.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <svg class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools &amp; guides</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/exif-remover" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">EXIF Remover</a>
          <a href="/merge-images" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Merge Images (NID A4)</a>
          {SEO_PAGES.slice(0, 5).map((item) => (
            <a
              href={`/${item.slug}`}
              class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 hover:border-zinc-400 transition"
            >
              {item.shortName}
            </a>
          ))}
          <a href="/guides/image-redaction-guide-why-blur-and-pixelation-fail" class="px-3.5 py-2 rounded-xl bg-blue-500/8 border border-blue-500/20 text-xs font-semibold text-blue-700 dark:text-blue-400 transition">Blur vs Solid Blackout Redaction Guide →</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
