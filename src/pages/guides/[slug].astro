---
import Layout from '../../layouts/Layout.astro';
import { GUIDES } from '../../data/guides';
import type { GuideArticle } from '../../data/guideArticles/types';

export function getStaticPaths() {
  return (GUIDES as GuideArticle[]).map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props as { guide: GuideArticle };
const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/guides/${guide.slug}`;

function slugifyHeading(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .slice(0, 60);
}

const sectionsWithIds = guide.sections.map((sec, idx) => ({
  ...sec,
  id: slugifyHeading(sec.heading) || `section-${idx + 1}`,
}));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  datePublished: guide.updatedAt,
  dateModified: guide.updatedAt,
  mainEntityOfPage: pageUrl,
  author: {
    '@type': 'Organization',
    name: 'ImageLabKit Editorial Team',
    url: siteBase,
  },
  publisher: {
    '@type': 'Organization',
    name: 'ImageLabKit',
    logo: {
      '@type': 'ImageObject',
      url: `${siteBase}/logo.png?v=2`,
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${siteBase}/guides` },
    { '@type': 'ListItem', position: 3, name: guide.title, item: pageUrl },
  ],
};

const schemas: Record<string, unknown>[] = [articleSchema, breadcrumbSchema];

if (guide.faqs && guide.faqs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

// Show up to 6 relevant guides (same category prioritized)
const allOther = (GUIDES as GuideArticle[]).filter((g) => g.slug !== guide.slug);
const sameCat = allOther.filter((g) => g.category === guide.category);
const diffCat = allOther.filter((g) => g.category !== guide.category);
const relatedGuides = [...sameCat, ...diffCat].slice(0, 6);
---

<Layout
  title={guide.metaTitle}
  description={guide.description}
  schemas={schemas}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16 animate-fade-up">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex flex-wrap items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <a href="/guides" class="hover:text-zinc-950 dark:hover:text-white transition">Guides</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">{guide.category}</span>
    </nav>

    <header class="space-y-4 mb-8">
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-semibold">
        <a
          href="/guides"
          class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 hover:bg-blue-500/15 transition"
        >
          {guide.category}
        </a>
        <span class="text-zinc-400 tabular-nums">{guide.readTime}</span>
        <span class="text-zinc-300">·</span>
        <time datetime={guide.updatedAt} class="text-zinc-400 tabular-nums">
          Updated {guide.updatedAt}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 leading-[1.15]">
        {guide.title}
      </h1>

      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
        {guide.intro}
      </p>
    </header>

    <!-- Key Takeaways Summary -->
    {guide.keyTakeaways && guide.keyTakeaways.length > 0 && (
      <section class="rounded-3xl border border-blue-500/20 bg-blue-50/50 dark:bg-blue-950/20 p-5 sm:p-6 mb-7 space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-400">
          Key Takeaways
        </h2>
        <ul class="space-y-2">
          {guide.keyTakeaways.map((point) => (
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-200 leading-relaxed">
              <svg class="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Table of Contents -->
    {sectionsWithIds.length >= 3 && (
      <nav aria-label="Table of contents" class="studio-card rounded-2xl p-4 sm:p-5 mb-7">
        <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 mb-2.5">
          In this guide
        </p>
        <ol class="grid sm:grid-cols-2 gap-x-6 gap-y-1.5 text-xs sm:text-[13px]">
          {sectionsWithIds.map((sec, i) => (
            <li>
              <a
                href={`#${sec.id}`}
                class="text-zinc-600 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-baseline gap-2"
              >
                <span class="text-[11px] font-mono text-zinc-400 shrink-0">{i + 1}.</span>
                <span class="leading-snug">{sec.heading}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- Main Editorial Content -->
    <div class="studio-card rounded-3xl p-6 sm:p-9 space-y-9">
      {sectionsWithIds.map((section) => (
        <section id={section.id} class="space-y-3.5 scroll-mt-24">
          <h2 class="text-lg sm:text-xl font-bold text-zinc-950 leading-snug">
            {section.heading}
          </h2>

          {section.paragraphs.map((p) => (
            <p class="text-sm sm:text-[15px] text-zinc-600 leading-relaxed">{p}</p>
          ))}

          {section.bullets && (
            <ul class="space-y-2.5 pt-1">
              {section.bullets.map((b) => (
                <li class="flex items-start gap-2.5 text-sm text-zinc-600 leading-relaxed">
                  <svg class="w-4 h-4 text-blue-600 shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          )}

          {section.table && (
            <div class="overflow-x-auto rounded-2xl border border-zinc-200/80 mt-3">
              <table class="w-full text-left text-xs sm:text-[13px] border-collapse">
                <thead class="bg-zinc-50 border-b border-zinc-200/80">
                  <tr>
                    {section.table.headers.map((h) => (
                      <th class="px-4 py-3 font-bold text-zinc-900 whitespace-nowrap">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100">
                  {section.table.rows.map((row) => (
                    <tr class="hover:bg-zinc-50/70">
                      {row.map((cell, idx) => (
                        <td
                          class={`px-4 py-3 ${
                            idx === 0 ? 'font-semibold text-zinc-900 whitespace-nowrap' : 'text-zinc-600'
                          }`}
                        >
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.callout && (
            <aside class="rounded-2xl border border-zinc-200/90 dark:border-zinc-800 bg-zinc-50/80 dark:bg-zinc-900/60 p-4 sm:p-5 space-y-1.5 mt-3">
              <p class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                {section.callout.title}
              </p>
              <p class="text-xs sm:text-[13.5px] text-zinc-600 dark:text-zinc-300 leading-relaxed">
                {section.callout.body}
              </p>
            </aside>
          )}
        </section>
      ))}
    </div>

    <!-- Frequently Asked Questions -->
    {guide.faqs && guide.faqs.length > 0 && (
      <section class="mt-10 space-y-4">
        <h2 class="text-lg font-bold text-zinc-950">Frequently Asked Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {guide.faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <svg class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Try the Tools Mentioned -->
    <section class="mt-10 space-y-3">
      <h2 class="text-sm font-bold text-zinc-900">Try these free tools locally on ImageLabKit</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {guide.relatedTools.map((tool) => (
          <a
            href={tool.href}
            class="group studio-card rounded-2xl p-4 hover:border-blue-500/40 transition flex items-center justify-between gap-3"
          >
            <div class="min-w-0">
              <div class="text-sm font-bold text-zinc-950 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                {tool.label}
              </div>
              <div class="text-xs text-zinc-500 mt-0.5 truncate">{tool.desc}</div>
            </div>
            <svg class="w-4 h-4 text-zinc-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Related Guides -->
    <nav aria-label="More Guides" class="mt-12 pt-8 border-t border-zinc-200/80 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold text-zinc-900">More technical guides</h2>
        <a href="/guides" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
          View all guides →
        </a>
      </div>
      <div class="grid sm:grid-cols-3 gap-3">
        {relatedGuides.map((g) => (
          <a
            href={`/guides/${g.slug}`}
            class="studio-card rounded-2xl p-4 hover:border-blue-500/40 transition flex flex-col justify-between gap-2"
          >
            <span class="text-[10.5px] font-bold uppercase tracking-wider text-zinc-400">
              {g.category}
            </span>
            <span class="text-xs font-bold text-zinc-900 leading-snug">{g.title}</span>
          </a>
        ))}
      </div>
    </nav>
  </article>
</Layout>
