---
import Layout from '../../layouts/Layout.astro';
import { GUIDES } from '../../data/guides';
import type { GuideArticle } from '../../data/guideArticles/types';

const guides = GUIDES as GuideArticle[];
const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/guides`;

const title = 'Image, PDF & Privacy Optimization Guides | ImageLabKit';
const description =
  'In-depth, tested technical guides on WebP vs AVIF benchmarks, PDF compression tests, EXIF GPS privacy, US/UK/EU passport 300 DPI printing, Core Web Vitals, QR/barcode standards, and browser-native workflows.';

const categoryCounts = new Map<string, number>();
for (const g of guides) {
  categoryCounts.set(g.category, (categoryCounts.get(g.category) ?? 0) + 1);
}

const orderedCategories = [
  'Optimization',
  'PDF Workflow',
  'Privacy',
  'Formats',
  'Graphics & Text',
].filter((cat) => (categoryCounts.get(cat) ?? 0) > 0);

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ImageLabKit Technical Guides',
  url: pageUrl,
  description,
  numberOfItems: guides.length,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: pageUrl },
  ],
};
---

<Layout
  title={title}
  description={description}
  schemas={[collectionSchema, breadcrumbSchema]}
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Guides</span>
    </nav>

    <header class="max-w-3xl mb-8 animate-fade-up">
      <p class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">
        Editorial &amp; Benchmarks · {guides.length} Guides
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Image, PDF &amp; Privacy Guides
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base leading-relaxed">
        Original, tested technical playbooks on modern image codecs, PDF compression, metadata privacy, 300 DPI print specs, and fast browser-side workflows.
      </p>
    </header>

    <!-- Instant Search & Category Filter -->
    <div class="studio-card rounded-3xl p-3 sm:p-4 mb-8 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div class="relative flex-1 max-w-md">
        <svg class="w-4 h-4 text-zinc-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          id="guide-search"
          type="search"
          autocomplete="off"
          placeholder="Search guides: webp, avif, pdf, exif, passport, qr..."
          aria-label="Search guides"
          class="w-full pl-10 pr-4 py-2 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/70 text-xs sm:text-sm text-zinc-950 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500/40"
        />
      </div>

      <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5 md:pb-0" role="tablist" aria-label="Filter guide categories">
        <button
          type="button"
          data-guide-cat="all"
          class="guide-pill shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold border bg-blue-600 text-white border-blue-600 cursor-pointer transition"
        >
          All ({guides.length})
        </button>
        {orderedCategories.map((cat) => (
          <button
            type="button"
            data-guide-cat={cat}
            class="guide-pill shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold border bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-300 hover:border-blue-500/50 cursor-pointer transition"
          >
            {cat} ({categoryCounts.get(cat)})
          </button>
        ))}
      </div>
    </div>

    <!-- Guides Grid -->
    <div id="guides-grid" class="grid sm:grid-cols-2 gap-5">
      {guides.map((guide) => (
        <a
          href={`/guides/${guide.slug}`}
          data-cat={guide.category}
          data-search={`${guide.title} ${guide.description} ${guide.category} ${guide.slug.replace(/-/g, ' ')}`.toLowerCase()}
          class="guide-card group studio-card rounded-3xl p-6 hover:-translate-y-0.5 hover:border-blue-500/40 transition-all duration-200 flex flex-col justify-between gap-5"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2 text-[11px] font-semibold">
              <span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400">
                {guide.category}
              </span>
              <span class="text-zinc-400 tabular-nums">{guide.readTime}</span>
            </div>

            <h2 class="text-lg sm:text-xl font-bold text-zinc-950 leading-snug group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
              {guide.title}
            </h2>

            <p class="text-xs sm:text-[13.5px] text-zinc-500 leading-relaxed">
              {guide.description}
            </p>
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-zinc-200/80 text-xs font-semibold text-zinc-700 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
            <span>Read full guide</span>
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div id="guides-empty" class="hidden studio-card rounded-3xl p-10 text-center space-y-2 mt-4">
      <p class="text-sm font-bold text-zinc-900 dark:text-zinc-100">No guides match your search</p>
      <p class="text-xs text-zinc-500">Try keywords like "webp", "pdf", "exif", "passport", "qr", or "barcode".</p>
    </div>
  </section>

  <script is:inline>
    (function () {
      const input = document.getElementById('guide-search');
      const pills = Array.from(document.querySelectorAll('.guide-pill'));
      const cards = Array.from(document.querySelectorAll('.guide-card'));
      const emptyBox = document.getElementById('guides-empty');
      if (!input || cards.length === 0) return;

      let activeCat = 'all';

      function updatePills() {
        pills.forEach(function (pill) {
          const on = pill.getAttribute('data-guide-cat') === activeCat;
          if (on) {
            pill.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
            pill.classList.remove('bg-white', 'dark:bg-zinc-900', 'border-zinc-200', 'dark:border-zinc-800', 'text-zinc-600', 'dark:text-zinc-300');
          } else {
            pill.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
            pill.classList.add('bg-white', 'dark:bg-zinc-900', 'border-zinc-200', 'dark:border-zinc-800', 'text-zinc-600', 'dark:text-zinc-300');
          }
        });
      }

      function filterGuides() {
        const q = (input.value || '').trim().toLowerCase();
        const terms = q ? q.split(/\s+/).filter(Boolean) : [];
        let shown = 0;

        cards.forEach(function (card) {
          const catMatch = activeCat === 'all' || card.getAttribute('data-cat') === activeCat;
          const hay = card.getAttribute('data-search') || '';
          const textMatch = terms.length === 0 || terms.every(function (t) { return hay.includes(t); });
          const visible = catMatch && textMatch;
          card.classList.toggle('hidden', !visible);
          if (visible) shown++;
        });

        if (emptyBox) emptyBox.classList.toggle('hidden', shown > 0);
      }

      input.addEventListener('input', filterGuides);
      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          activeCat = pill.getAttribute('data-guide-cat') || 'all';
          updatePills();
          filterGuides();
        });
      });
    })();
  </script>
</Layout>
