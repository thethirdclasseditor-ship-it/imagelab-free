---
import Layout from '../layouts/Layout.astro';
import VisualCropTool from '../components/VisualCropTool';
import { SEO_PAGES } from '../data/seoPages';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/crop-image`;

const title = 'Crop & Rotate Image Online Free (Visual Editor) | ImageLab';
const description =
  'Crop, rotate, and flip JPG, PNG, WEBP, or HEIC photos visually in your browser. Includes 300x300 job photo, 300x80 signature, and 16:9 YouTube presets.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Visual Image Cropper & Rotator',
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};
---

<Layout title={title} description={description} schemas={[schema]}>
  <article class="max-w-5xl mx-auto px-4 pt-6 sm:pt-10 pb-10">
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500 mb-4 flex items-center gap-1.5">
      <a href="/" class="hover:text-blue-600 font-medium">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">Visual Crop & Rotate</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-7">
      <span class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3">
        Interactive Visual Editor
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
        Visual Image Cropper & Rotator
      </h1>
      <p class="text-slate-600 mt-2.5 text-sm sm:text-base">
        Frame your exact subject with rule-of-thirds guides, rotate or flip, and export in MozJPEG or WEBP—all offline in your browser.
      </p>
    </header>

    <VisualCropTool client:load />

    <section class="mt-10 grid sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900 text-sm">Exact Job & Signature Framing</h2>
        <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
          Pick 300×300 Job Photo or 300×80 Signature presets to frame faces or ink cleanly and stay under form KB limits automatically.
        </p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900 text-sm">Lossless 90° Rotate & Flip</h2>
        <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
          Fix sideways phone shots or mirror selfies in one tap before cropping with zero cloud uploads.
        </p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900 text-sm">MozJPEG & WebP Export</h2>
        <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
          Every cropped photo is compressed with studio-grade WebAssembly codecs for sharp detail at minimal file size.
        </p>
      </div>
    </section>

    <nav aria-label="More Tools" class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-lg font-bold text-slate-900 mb-4">More Free Tools</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        {SEO_PAGES.slice(0, 8).map((item) => (
          <a
            href={`/${item.slug}`}
            class="px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs sm:text-sm font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 transition"
          >
            {item.shortName}
          </a>
        ))}
      </div>
    </nav>
  </article>
</Layout>
