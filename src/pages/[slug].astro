---
import Layout from '../layouts/Layout.astro';
import ToolWorkspace from '../components/ToolWorkspace';
import { SEO_PAGES, type SeoToolPage } from '../data/seoPages';

type EnrichedSeoPage = SeoToolPage & {
  overview?: string[];
  useCases?: { title: string; desc: string }[];
  specTable?: { headers: string[]; rows: string[][] };
  relatedGuides?: { label: string; href: string }[];
};

export function getStaticPaths() {
  return SEO_PAGES.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: EnrichedSeoPage };
const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/${page.slug}`;

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${page.h1} — ImageLabKit`,
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: page.metaDescription,
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to use ${page.h1}`,
  description: page.subtitle,
  step: page.howToSteps.map((text, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    text,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: page.h1, item: pageUrl },
  ],
};

// Prioritize same-category presets first for stronger topical internal linking
const sameCat = SEO_PAGES.filter((p) => p.slug !== page.slug && p.category === page.category);
const otherCat = SEO_PAGES.filter((p) => p.slug !== page.slug && p.category !== page.category);
const relatedPages = [...sameCat, ...otherCat].slice(0, 12);
---

<Layout
  title={page.title}
  description={page.metaDescription}
  schemas={[softwareSchema, howToSchema, faqSchema, breadcrumbSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">{page.shortName}</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        {page.h1}
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        {page.subtitle}
      </p>
    </header>

    <ToolWorkspace
      client:load
      initialMode={page.toolType}
      showModeTabs={false}
      defaults={page.defaults}
    />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <!-- Detailed Overview (when available) -->
      {page.overview && page.overview.length > 0 && (
        <section class="studio-card rounded-3xl p-6 sm:p-8 space-y-3.5">
          <h2 class="text-lg font-bold text-zinc-950">Why use {page.shortName} on ImageLabKit?</h2>
          {page.overview.map((paragraph) => (
            <p class="text-xs sm:text-[14px] text-zinc-600 leading-relaxed">{paragraph}</p>
          ))}
        </section>
      )}

      <!-- Real-World Use Cases -->
      {page.useCases && page.useCases.length > 0 && (
        <section class="space-y-4">
          <h2 class="text-lg font-bold text-zinc-950">Common use cases</h2>
          <div class="grid sm:grid-cols-3 gap-4">
            {page.useCases.map((uc) => (
              <div class="studio-card rounded-2xl p-5 space-y-1.5">
                <h3 class="text-sm font-bold text-zinc-950">{uc.title}</h3>
                <p class="text-xs text-zinc-500 leading-relaxed">{uc.desc}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- How It Works -->
      <section class="studio-card rounded-3xl p-6 sm:p-8">
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Step-by-step tutorial</h2>
        <ol class="grid sm:grid-cols-3 gap-4">
          {page.howToSteps.map((step, index) => (
            <li class="flex flex-col gap-2">
              <span class="w-6 h-6 rounded-lg bg-blue-600/10 text-blue-600 dark:text-blue-400 text-xs font-bold flex items-center justify-center tabular-nums">
                {index + 1}
              </span>
              <p class="text-xs sm:text-[13px] text-zinc-600 leading-relaxed">{step}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Technical Benchmark / Specification Table -->
      {page.specTable && (
        <section class="studio-card rounded-3xl p-6 sm:p-8 space-y-3">
          <h2 class="text-lg font-bold text-zinc-950">Quick technical reference</h2>
          <div class="overflow-x-auto rounded-2xl border border-zinc-200/80">
            <table class="w-full text-left text-xs sm:text-[13px] border-collapse">
              <thead class="bg-zinc-50 border-b border-zinc-200/80">
                <tr>
                  {page.specTable.headers.map((h) => (
                    <th class="px-4 py-3 font-bold text-zinc-900 whitespace-nowrap">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100">
                {page.specTable.rows.map((row) => (
                  <tr class="hover:bg-zinc-50/70">
                    {row.map((cell, idx) => (
                      <td class={`px-4 py-3 ${idx === 0 ? 'font-semibold text-zinc-900 whitespace-nowrap' : 'text-zinc-600'}`}>
                        {cell}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- Unique Pro Tips -->
      {page.proTips && page.proTips.length > 0 && (
        <section class="studio-card rounded-3xl p-6 sm:p-8">
          <h2 class="text-lg font-bold text-zinc-950 mb-4">Tips for best results</h2>
          <ul class="space-y-2.5">
            {page.proTips.map((tip) => (
              <li class="flex items-start gap-2.5 text-xs sm:text-[13.5px] text-zinc-600 leading-relaxed">
                <svg class="w-4 h-4 text-blue-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Clean Accordion FAQ -->
      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Frequently Asked Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {page.faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <svg class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Related Deep-Dive Guides -->
      {page.relatedGuides && page.relatedGuides.length > 0 && (
        <section class="studio-card rounded-3xl p-6 space-y-3">
          <h2 class="text-sm font-bold text-zinc-950">Learn more in our guides</h2>
          <div class="flex flex-wrap gap-2">
            {page.relatedGuides.map((g) => (
              <a
                href={g.href}
                class="px-3.5 py-2 rounded-xl bg-blue-500/8 border border-blue-500/20 text-xs font-semibold text-blue-700 dark:text-blue-400 hover:bg-blue-500/15 transition"
              >
                {g.label} →
              </a>
            ))}
          </div>
        </section>
      )}

      <nav aria-label="More Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          {relatedPages.map((item) => (
            <a
              href={`/${item.slug}`}
              class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 hover:border-zinc-400 transition"
            >
              {item.shortName}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </article>
</Layout>
