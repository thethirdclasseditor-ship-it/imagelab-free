---
import Layout from '../layouts/Layout.astro';
import LiveEnhancerTool from '../components/LiveEnhancerTool';
import { SEO_PAGES } from '../data/seoPages';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/photo-enhancer`;

const title = 'Free Online Photo Enhancer (Live Preview, HD) | ImageLab';
const description =
  'Enhance photo lighting, sharpness, contrast, warmth, and colors with real-time live preview. 100% free browser photo studio with zero server uploads.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Live Studio Photo Enhancer',
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};
---

<Layout title={title} description={description} schemas={[schema]}>
  <article class="max-w-5xl mx-auto px-4 pt-6 sm:pt-10 pb-10">
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500 mb-4 flex items-center gap-1.5">
      <a href="/" class="hover:text-blue-600 font-medium">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">Studio Photo Enhancer</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-7">
      <span class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3">
        Real-Time Live Preview
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
        Live Studio Photo Enhancer
      </h1>
      <p class="text-slate-600 mt-2.5 text-sm sm:text-base">
        Watch brightness, contrast, clarity, and color warmth update in real time—plus one-click presets for dark photos, portraits, and scanned documents.
      </p>
    </header>

    <LiveEnhancerTool client:load />

    <nav aria-label="More Tools" class="mt-12 border-t border-slate-200 pt-8">
      <h2 class="text-lg font-bold text-slate-900 mb-4">More Free Tools</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        {SEO_PAGES.slice(0, 8).map((item) => (
          <a
            href={`/${item.slug}`}
            class="px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs sm:text-sm font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 transition"
          >
            {item.shortName}
          </a>
        ))}
      </div>
    </nav>
  </article>
</Layout>
