---
import Layout from '../layouts/Layout.astro';

const title = 'AI Photo Enhancer & Upscaler (Coming Soon) | ImageLab';
const description =
  'ImageLab AI Photo Enhancer is upgrading to fast, high-definition neural restoration with zero browser model downloads. Coming soon.';
---

<Layout title={title} description={description} noindex={true}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16 animate-fade-up">
    <div class="studio-card rounded-3xl p-8 sm:p-14 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/12 border border-amber-500/25 text-amber-700 dark:text-amber-300 text-xs font-bold tracking-wide uppercase">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        Coming Soon
      </div>

      <div class="w-16 h-16 rounded-2xl bg-blue-600/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <line x1="21" x2="14" y1="4" y2="4" />
          <line x1="10" x2="3" y1="4" y2="4" />
          <line x1="21" x2="12" y1="12" y2="12" />
          <line x1="8" x2="3" y1="12" y2="12" />
          <line x1="21" x2="16" y1="20" y2="20" />
          <line x1="12" x2="3" y1="20" y2="20" />
          <circle cx="12" cy="4" r="2" />
          <circle cx="10" cy="12" r="2" />
          <circle cx="14" cy="20" r="2" />
        </svg>
      </div>

      <div class="max-w-xl mx-auto space-y-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 leading-[1.12]">
          AI Photo Enhancer &amp; Upscaler
        </h1>
        <p class="text-sm sm:text-base text-zinc-500 leading-relaxed">
          This tool is currently unavailable while we upgrade it to true high-definition AI face &amp; detail restoration—fast, crisp, and without slow browser downloads.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-3 max-w-2xl mx-auto pt-2 text-left">
        <div class="rounded-2xl border border-zinc-200/80 bg-zinc-50/70 p-4">
          <p class="text-xs font-bold text-zinc-900">True HD Clarity</p>
          <p class="text-[11.5px] text-zinc-500 mt-1">Restores soft, blurry photos naturally without harsh sharpening artifacts.</p>
        </div>
        <div class="rounded-2xl border border-zinc-200/80 bg-zinc-50/70 p-4">
          <p class="text-xs font-bold text-zinc-900">Seconds, Not Minutes</p>
          <p class="text-[11.5px] text-zinc-500 mt-1">Accelerated restoration with zero large files downloaded to your phone.</p>
        </div>
        <div class="rounded-2xl border border-zinc-200/80 bg-zinc-50/70 p-4">
          <p class="text-xs font-bold text-zinc-900">Live Split Compare</p>
          <p class="text-[11.5px] text-zinc-500 mt-1">Inspect before and after at 2× zoom before saving your HD copy.</p>
        </div>
      </div>

      <div class="pt-4 border-t border-zinc-200/80 space-y-3">
        <p class="text-xs font-semibold text-zinc-500">Need quick lighting or clarity adjustments right now?</p>
        <div class="flex flex-wrap items-center justify-center gap-2.5">
          <a href="/auto-enhance-photo" class="btn-studio-accent px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold">
            Batch Color &amp; Light Enhancer
          </a>
          <a
            href="/brighten-dark-photo"
            class="px-4 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-xs sm:text-sm font-semibold text-zinc-700 transition"
          >
            Brighten Dark Photo
          </a>
          <a
            href="/image-to-text"
            class="px-4 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-xs sm:text-sm font-semibold text-zinc-700 transition"
          >
            Image to Text (OCR)
          </a>
          <a
            href="/"
            class="px-4 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-xs sm:text-sm font-semibold text-zinc-700 transition"
          >
            Back to Studio
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
