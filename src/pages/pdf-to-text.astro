---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PdfToTextTool from '../components/PdfToTextTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/pdf-to-text`;

const title = 'PDF to Text Converter Online Free — Extract Text to TXT & Markdown | ImageLabKit';
const description =
  'Extract clean, editable text from any digital PDF locally in your browser. Filter specific page ranges, copy individual pages, or download as plain .TXT and Markdown (.MD) with zero server uploads.';

const faqs = [
  {
    q: 'Does this PDF to Text tool work on scanned or handwritten PDFs?',
    a: 'This tool extracts embedded digital text instantly with zero wait time. If your PDF is a scanned photo without a text layer, convert the pages with PDF to JPG and use our AI Image to Text (OCR) tool instead.',
  },
  {
    q: 'Can I extract text from only specific pages of a large PDF?',
    a: 'Yes. After loading your file, type any page range such as "1-5" or "2, 4, 8-10" in the Pages box to filter, copy, or download only those pages.',
  },
  {
    q: 'Are my PDF documents uploaded anywhere?',
    a: 'Never. Text parsing runs 100% locally inside your browser tab using PDF.js—confidential reports, contracts, and study notes never leave your device.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLabKit Free PDF to Text Extractor',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'PDF to Text', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">PDF to Text</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        PDF to Text Extractor
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Extract clean, structured text from multi-page PDFs in one second — copy by page or export as .TXT and .MD.
      </p>
    </header>

    <PdfToTextTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Instant Browser Parsing</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Reads multi-page digital PDFs directly in your browser while preserving clean line breaks and paragraph spacing.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Page Range &amp; Keyword Filter</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Switch between combined output and page-by-page cards, search inside extracted pages, and export to .TXT or Markdown.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">100% Private &amp; Unlimited</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Zero file uploads, zero daily limits—safe for academic papers, legal documents, and bank statements.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Related Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/image-to-text" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Image to Text (OCR)</a>
          <a href="/word-counter" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Word Counter</a>
          <a href="/pdf-to-jpg" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">PDF to JPG</a>
          <a href="/add-page-numbers-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Add Page Numbers</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
