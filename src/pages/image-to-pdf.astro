---
import Layout from '../layouts/Layout.astro';
import ImageToPdfTool from '../components/ImageToPdfTool';
import { SEO_PAGES } from '../data/seoPages';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/image-to-pdf`;

const title = 'Image to PDF Converter Free (No Upload, A4) | ImageLab';
const description =
  'Convert JPG, PNG, WEBP, and HEIC images into a single multi-page A4 or custom PDF locally in your browser. Reorder pages, zero watermarks, 100% private.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free Image to PDF Converter',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};
---

<Layout title={title} description={description} schemas={[schema]}>
  <article class="max-w-4xl mx-auto px-4 pt-6 sm:pt-10 pb-10">
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500 mb-4 flex items-center gap-1.5">
      <a href="/" class="hover:text-blue-600 font-medium">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">Image to PDF</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-7">
      <span class="inline-block px-3 py-1 rounded-full bg-red-50 text-red-700 text-xs font-semibold mb-3">
        Free Document Tool
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
        Image to PDF Converter
      </h1>
      <p class="text-slate-600 mt-2.5 text-sm sm:text-base">
        Merge up to 30 photos, certificates, or class notes into one clean A4 or Letter PDF right inside your browser.
      </p>
    </header>

    <ImageToPdfTool client:load />

    <section class="mt-10 grid sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900 text-sm">Safe for NID & Certificates</h2>
        <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
          Everything runs offline inside your browser tab—ideal for sensitive admission papers, passports, and mark sheets.
        </p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900 text-sm">Reorder & Control Size</h2>
        <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
          Arrange pages in exact order, choose A4 or Full-Bleed Fit, and tune MozJPEG quality to keep PDF files lightweight.
        </p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <h2 class="font-bold text-slate-900 text-sm">Zero Watermarks</h2>
        <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
          Download clean, print-ready PDFs with no branding, no forced signup, and no daily page limits.
        </p>
      </div>
    </section>

    <nav aria-label="More Tools" class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-lg font-bold text-slate-900 mb-4">More Free Tools</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        {SEO_PAGES.slice(0, 8).map((item) => (
          <a
            href={`/${item.slug}`}
            class="px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs sm:text-sm font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 transition"
          >
            {item.shortName}
          </a>
        ))}
      </div>
    </nav>
  </article>
</Layout>
