---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | ImageLabKit"
  description="The page you are looking for does not exist. Explore ImageLabKit's free browser-based image, PDF, text, and graphics tools."
  noindex={true}
>
  <section class="max-w-xl mx-auto px-4 sm:px-6 py-20 text-center animate-fade-up">
    <div class="studio-card rounded-3xl p-8 sm:p-12 space-y-5">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">
        Error 404
      </p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-950">Page not found</h1>
      <p class="text-sm text-zinc-500 leading-relaxed">
        The tool or link you opened may have moved. Jump straight back into the studio below.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2.5 pt-2">
        <a href="/" class="btn-studio-accent px-5 py-2.5 rounded-xl text-sm font-semibold">
          Open ImageLabKit Studio
        </a>
        <a
          href="/merge-pdf"
          class="px-4 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-sm font-semibold text-zinc-700 transition"
        >
          Merge PDF
        </a>
      </div>

      <div class="pt-4 border-t border-zinc-200/80 flex flex-wrap justify-center gap-2 text-xs text-zinc-500">
        <a href="/image-to-text" class="hover:text-zinc-950 dark:hover:text-white transition">Image to Text (OCR)</a>
        <span>·</span>
        <a href="/merge-images" class="hover:text-zinc-950 dark:hover:text-white transition">Merge Images (NID A4)</a>
        <span>·</span>
        <a href="/passport-photo-sheet" class="hover:text-zinc-950 dark:hover:text-white transition">Passport Sheet</a>
        <span>·</span>
        <a href="/qr-code-generator" class="hover:text-zinc-950 dark:hover:text-white transition">QR Generator</a>
      </div>
    </div>
  </section>
</Layout>
