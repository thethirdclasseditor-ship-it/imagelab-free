---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PdfPageNumbersTool from '../components/PdfPageNumbersTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/add-page-numbers-pdf`;

const title = 'Add Page Numbers to PDF Online Free — Skip Cover & Custom Format | ImageLabKit';
const description =
  'Insert customizable page numbers into any PDF document locally in your browser. Choose top or bottom alignment, skip cover pages, mirror facing book pages, and export losslessly with zero file uploads.';

const faqs = [
  {
    q: 'Can I skip the cover page and start numbering from page 2?',
    a: 'Yes. Toggle "Skip cover page (start on page 2)" or set "From Page" to 2 while keeping "First Number" at 1. Page 1 stays completely untouched and page 2 gets labeled as 1.',
  },
  {
    q: 'Does adding page numbers reduce PDF text sharpness or file quality?',
    a: 'No. Page numbers are stamped directly as vector text layers using pdf-lib, so all original fonts, links, and images remain 100% lossless.',
  },
  {
    q: 'Is my PDF uploaded to any server?',
    a: 'Never. The entire numbering process happens inside your browser tab, making it safe for university theses, legal contracts, and office reports.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLabKit Free Add Page Numbers to PDF',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Add Page Numbers to PDF', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Add Page Numbers to PDF</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Add Page Numbers to PDF
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Stamp clean vector page numbers onto reports, assignments &amp; theses — skip cover pages, choose formats, and stay 100% private.
      </p>
    </header>

    <PdfPageNumbersTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Skip Cover &amp; Custom Ranges</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Leave title pages unnumbered, start numbering from any page, and pick formats like "1", "1 / 12", or "Page 1 of 12".
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Book &amp; Facing-Page Mirror</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Automatically alternate left and right outer corners on odd and even pages for double-sided printing.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Lossless &amp; Instant</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Runs locally in your browser without re-compressing pages or uploading confidential PDFs to any server.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Related Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/merge-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Merge PDF</a>
          <a href="/organize-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Organize &amp; Rotate PDF</a>
          <a href="/compress-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Compress PDF</a>
          <a href="/sign-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Sign PDF</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
