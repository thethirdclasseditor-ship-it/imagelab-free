---
import Layout from '../layouts/Layout.astro';
import BgRemoverTool from '../components/BgRemoverTool';
import { SEO_PAGES } from '../data/seoPages';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/remove-background`;

const title = 'AI Background Remover Free Online (HD) | ImageLab';
const description =
  'Remove image backgrounds automatically in HD directly inside your browser. Swap to transparent PNG, white, or custom colors and export 300×300 portraits with zero uploads.';

const faqs = [
  {
    q: 'Does ImageLab upload my photo to remove the background?',
    a: 'No. Background segmentation runs 100% locally inside your browser using on-device AI. Only the open-source model weights are cached from CDN on first use.',
  },
  {
    q: 'Can I replace the removed background with white or light blue?',
    a: 'Yes. After cutout completes, pick Transparent PNG, White, Light Blue, Sky Blue, Gray, or any custom hex color—and download full-resolution HD or a 300×300 portrait under 100KB.',
  },
  {
    q: 'Why does the first image take a few extra seconds?',
    a: 'Your browser downloads and caches the AI segmentation weights once on the first run. Every image after that starts immediately from local cache.',
  },
  {
    q: 'Does it support iPhone HEIC and large phone photos?',
    a: 'Yes. HEIC files are decoded locally, and oversized photos are safely capped at 2048px before inference to keep mobile memory fast and stable.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab AI Background Remover',
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'AI Background Remover', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">AI Background Remover</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        AI Background Remover
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Remove backgrounds in HD locally in your browser — export transparent PNG or solid colors.
      </p>
    </header>

    <BgRemoverTool client:only="react">
      <div
        slot="fallback"
        class="studio-card rounded-3xl min-h-[420px] flex flex-col items-center justify-center gap-3 p-8 text-center"
      >
        <div class="w-8 h-8 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></div>
        <p class="text-xs font-semibold text-zinc-500">Loading AI Background Studio...</p>
      </div>
    </BgRemoverTool>

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Full-Resolution Transparent PNG</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            No low-resolution paywalls—save clean alpha-channel cutouts ready for design tools and product listings.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">1-Click Background Colors</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Switch to pure white, light blue, or any custom color and export directly as optimized MozJPEG.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Private On-Device Portraits</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Safe for personal ID photos and client shoots—images stay strictly inside your browser memory.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <svg class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          {SEO_PAGES.slice(0, 8).map((item) => (
            <a
              href={`/${item.slug}`}
              class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 hover:border-zinc-400 transition"
            >
              {item.shortName}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </article>
</Layout>
