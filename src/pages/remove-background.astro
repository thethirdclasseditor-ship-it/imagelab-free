---
import Layout from '../layouts/Layout.astro';
import BgRemoverTool from '../components/BgRemoverTool';
import { SEO_PAGES } from '../data/seoPages';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/remove-background`;

const title = 'Free AI Background Remover Online (HD, No Signup, No Upload) | ImageLab';
const description =
  'Remove photo backgrounds automatically with 100% free on-device AI. Download full-resolution transparent PNG or add passport white & blue backgrounds.';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free AI Background Remover',
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const faqs = [
  {
    q: 'Is this AI Background Remover really 100% free in HD?',
    a: 'Yes! Unlike paid sites that lock HD downloads behind credits, ImageLab runs open AI models directly in your browser so you get full-resolution transparent PNGs for free.',
  },
  {
    q: 'Why does the first image take 10–25 seconds?',
    a: 'On your very first use, your browser downloads the compact AI model once and caches it locally. Every photo after that processes much faster.',
  },
  {
    q: 'Can I change my photo background to white or blue for passport/job forms?',
    a: 'Yes. Right after removing the background, tap White, Passport Blue, or any custom color to download a ready-to-upload JPG.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout title={title} description={description} schemas={[softwareSchema, faqSchema]}>
  <article class="max-w-4xl mx-auto px-4 pt-6 sm:pt-10 pb-10">
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500 mb-4 flex items-center gap-1.5">
      <a href="/" class="hover:text-blue-600 font-medium">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">AI Background Remover</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-7">
      <span class="inline-block px-3 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-semibold mb-3">
        100% Free On-Device AI
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
        AI Background Remover
      </h1>
      <p class="text-slate-600 mt-2.5 text-sm sm:text-base">
        Cut out portraits, products, and signatures in full HD—zero server uploads, no watermarks, free forever.
      </p>
    </header>

    <!-- client:only ensures zero SSR issues with browser AI -->
    <BgRemoverTool client:only="react" />

    <!-- FAQ -->
    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="font-semibold text-slate-900 text-sm sm:text-base">{faq.q}</h3>
            <p class="text-slate-600 text-sm mt-1.5 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal Links -->
    <nav aria-label="More Free Image Tools" class="mt-12 border-t border-slate-200 pt-8">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Next Step: Resize or Compress Your Cutout</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5">
        {SEO_PAGES.slice(0, 8).map((item) => (
          <a
            href={`/${item.slug}`}
            class="px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs sm:text-sm font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 transition"
          >
            {item.shortName}
          </a>
        ))}
      </div>
    </nav>
  </article>
</Layout>
