---
import Layout from '../layouts/Layout.astro';

const title = 'AI Background Remover (Coming Soon) | ImageLab';
const description =
  'ImageLab AI Background Remover is upgrading to instant studio-grade cloud cutouts with zero browser model downloads. Coming soon.';
---

<Layout title={title} description={description} noindex={true}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16 animate-fade-up">
    <div class="studio-card rounded-3xl p-8 sm:p-14 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/12 border border-amber-500/25 text-amber-700 dark:text-amber-300 text-xs font-bold tracking-wide uppercase">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        Coming Soon
      </div>

      <div class="w-16 h-16 rounded-2xl bg-blue-600/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
        </svg>
      </div>

      <div class="max-w-xl mx-auto space-y-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 leading-[1.12]">
          AI Background Remover
        </h1>
        <p class="text-sm sm:text-base text-zinc-500 leading-relaxed">
          This tool is currently unavailable while we upgrade it to a faster, studio-grade cutout engine with crisp hair edges and zero heavy model downloads.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-3 max-w-2xl mx-auto pt-2 text-left">
        <div class="rounded-2xl border border-zinc-200/80 bg-zinc-50/70 p-4">
          <p class="text-xs font-bold text-zinc-900">1–2 Second Cutouts</p>
          <p class="text-[11.5px] text-zinc-500 mt-1">Instant HD processing with zero waiting for browser weights.</p>
        </div>
        <div class="rounded-2xl border border-zinc-200/80 bg-zinc-50/70 p-4">
          <p class="text-xs font-bold text-zinc-900">Clean Hair &amp; Product Edges</p>
          <p class="text-[11.5px] text-zinc-500 mt-1">Studio precision for portraits, e-commerce shots, and logos.</p>
        </div>
        <div class="rounded-2xl border border-zinc-200/80 bg-zinc-50/70 p-4">
          <p class="text-xs font-bold text-zinc-900">Custom Backdrops</p>
          <p class="text-[11.5px] text-zinc-500 mt-1">Transparent PNG, solid colors, and 300×300 portrait export.</p>
        </div>
      </div>

      <div class="pt-4 border-t border-zinc-200/80 space-y-3">
        <p class="text-xs font-semibold text-zinc-500">Available right now in ImageLab</p>
        <div class="flex flex-wrap items-center justify-center gap-2.5">
          <a href="/" class="btn-studio-accent px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold">
            Convert &amp; Compress
          </a>
          <a
            href="/crop-image"
            class="px-4 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-xs sm:text-sm font-semibold text-zinc-700 transition"
          >
            Crop &amp; Rotate
          </a>
          <a
            href="/image-to-text"
            class="px-4 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-xs sm:text-sm font-semibold text-zinc-700 transition"
          >
            Image to Text (OCR)
          </a>
          <a
            href="/merge-pdf"
            class="px-4 py-2.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-100 text-xs sm:text-sm font-semibold text-zinc-700 transition"
          >
            PDF Suite
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
