---
import Layout from '../layouts/Layout.astro';
import PdfSuiteTool from '../components/PdfSuiteTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/pdf-to-jpg`;

const title = 'PDF to JPG Converter Free Online (HD) | ImageLabKit';
const description =
  'Convert PDF pages to high-resolution JPG, PNG, or WEBP images locally inside your browser using PDF.js and MozJPEG. Instant preview, ZIP download, zero uploads.';

const faqs = [
  {
    q: 'Can I convert only specific pages of a PDF to JPG?',
    a: 'Yes. Enter a page range like "1-3, 7" before converting, or leave it blank to render every page of the PDF into images.',
  },
  {
    q: 'Which resolution setting is best?',
    a: 'High HD (144 DPI) is ideal for crisp readability on phones and presentations. Use Print HD (216 DPI) for fine diagrams or high-detail graphics.',
  },
  {
    q: 'Can I save PDF pages as PNG or WEBP instead of JPG?',
    a: 'Yes. Switch the Image Format dropdown to Lossless PNG or compact LibWebP before clicking Convert.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLabKit Free PDF to JPG Converter',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'PDF to JPG', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">PDF to JPG</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        PDF to JPG Converter
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Turn PDF pages into sharp JPG, PNG, or WEBP images locally — download individually or as ZIP.
      </p>
    </header>

    <PdfSuiteTool client:load mode="pdf-to-jpg" />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <svg class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More PDF Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">More PDF tools &amp; guides</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/image-to-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Image to PDF</a>
          <a href="/merge-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Merge PDF</a>
          <a href="/pdf-to-text" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">PDF to Text</a>
          <a href="/image-to-text" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Image to Text (OCR)</a>
          <a href="/guides/pdf-to-text-vs-ai-ocr-extraction-guide" class="px-3.5 py-2 rounded-xl bg-blue-500/8 border border-blue-500/20 text-xs font-semibold text-blue-700 dark:text-blue-400 transition">PDF to Text vs AI OCR Guide →</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
