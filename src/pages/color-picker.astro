---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import ColorPaletteTool from '../components/ColorPaletteTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/color-picker`;

const title = 'Image Color Palette Extractor & Picker | ImageLabKit';
const description =
  'Extract dominant color palettes and pick exact HEX, RGB, and HSL codes from any photo or logo locally in your browser. Copy CSS variables or save a palette PNG card.';

const faqs = [
  {
    q: 'How do I pick an exact color from a specific spot on my logo or photo?',
    a: 'Click anywhere directly on the uploaded image preview to inspect the exact pixel underneath—its HEX, RGB, and HSL codes appear immediately with one-click copy buttons.',
  },
  {
    q: 'Can I export the extracted colors for CSS or design software?',
    a: 'Yes. Click Copy CSS Variables to grab a ready-to-paste :root block for your stylesheet, or click Save Palette PNG to download a clean visual swatch card with HEX and RGB labels.',
  },
  {
    q: 'Are my unpublished brand logos uploaded to any server?',
    a: 'Never. Color extraction and eyedropper sampling run 100% locally inside your browser tab.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLabKit Color Palette Extractor & Eyedropper',
  url: pageUrl,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Color Palette Picker', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Color Palette Picker</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Color Palette Extractor
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Extract brand palettes &amp; sample exact HEX, RGB, and HSL codes from any image locally.
      </p>
    </header>

    <ColorPaletteTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Instant Brand Palettes</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Automatically clusters 5, 6, or 8 dominant and accent shades from photos, UI screenshots, and logos.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Pixel-Exact Eyedropper</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Click any spot on your image to sample its exact HEX, RGB, and HSL values with one-click copying.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">CSS &amp; PNG Swatch Export</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Copy ready-made CSS custom properties or download a crisp horizontal palette PNG card for clients.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More Graphics Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools &amp; guides</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/favicon-generator" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Favicon Generator</a>
          <a href="/svg-to-png" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">SVG to PNG</a>
          <a href="/qr-code-generator" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">QR Code Generator</a>
          <a href="/watermark-image" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Batch Watermark</a>
          <a href="/guides/svg-vs-png-vs-ico-favicon-developer-guide" class="px-3.5 py-2 rounded-xl bg-blue-500/8 border border-blue-500/20 text-xs font-semibold text-blue-700 dark:text-blue-400 transition">SVG, PNG &amp; Favicon Guide →</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
