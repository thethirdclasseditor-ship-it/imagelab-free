---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import FaviconGeneratorTool from '../components/FaviconGeneratorTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/favicon-generator`;

const title = 'Favicon & ICO Generator Free Online | ImageLab';
const description =
  'Convert any PNG, SVG, or JPG logo into a multi-size favicon.ico (16, 32 & 48px), Apple Touch Icon (180px), Android 192/512px icons, and site.webmanifest in one ZIP.';

const faqs = [
  {
    q: 'What files are included in the downloaded Favicon Pack ZIP?',
    a: 'You get a true multi-resolution favicon.ico (containing 16×16, 32×32, and 48×48 frames), favicon-16x16.png, favicon-32x32.png, apple-touch-icon.png (180×180), android-chrome-192x192.png, android-chrome-512x512.png, and a ready-to-use site.webmanifest.',
  },
  {
    q: 'Can I upload a transparent SVG or PNG logo?',
    a: 'Yes. ImageLab supports SVG, PNG, JPG, WEBP, and HEIC logos—preserving transparency or letting you add custom background colors, rounded corners, and inner padding.',
  },
  {
    q: 'How do I install the favicons on my website?',
    a: 'Unzip the downloaded files into your website’s public or root folder, then click Copy HTML and paste the five <link> tags into your site’s <head> section.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free Favicon & ICO Generator',
  url: pageUrl,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Favicon Generator', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Favicon Generator</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Favicon &amp; ICO Generator
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Generate multi-size favicon.ico, Apple Touch, Android icons &amp; manifest in one click.
      </p>
    </header>

    <FaviconGeneratorTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">True Multi-Size .ICO</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Embeds crisp 16×16, 32×32, and 48×48 frames inside one real favicon.ico binary for every desktop browser.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">iOS &amp; Android Ready</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Generates 180px Apple Touch icons, 192/512px PWA icons, and a pre-configured site.webmanifest file.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Copy-Paste HTML Tags</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Preview your icon in a realistic browser tab, adjust rounding and padding, and copy clean &lt;head&gt; tags.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More Graphics Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/svg-to-png" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">SVG to PNG</a>
          <a href="/color-picker" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Color Palette Picker</a>
          <a href="/qr-code-generator" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">QR Code Generator</a>
          <a href="/crop-image" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Crop &amp; Rotate</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
