---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import OcrTool from '../components/OcrTool';
import { SEO_PAGES } from '../data/seoPages';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/image-to-text`;

const title = 'Image to Text (OCR) — Bangla & English | ImageLab';
const description =
  'Extract accurate English, Bengali (বাংলা), and handwritten text from photos, angled signs, and screenshots in 1–2 seconds with zero model downloads.';

const faqs = [
  {
    q: 'Can this read Bengali (বাংলা), angled signboards, and dark backgrounds?',
    a: 'Yes. Powered by advanced vision AI, ImageLab accurately reads complex Bengali conjuncts (যুক্তবর্ণ), mixed Bangla-English documents, white text on dark backgrounds, and angled real-world photos in 1–2 seconds.',
  },
  {
    q: 'Does it work on handwritten notes?',
    a: 'Yes. Switch the Mode selector at the top to Handwriting to transcribe clear handwritten notes in English or Bengali.',
  },
  {
    q: 'Are my uploaded images saved on ImageLab?',
    a: 'No. ImageLab never stores your photos or extracted text. Each image is resized compactly in your browser and sent transiently over HTTPS solely to extract the text.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab AI Image to Text OCR (English & Bengali)',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Image to Text (OCR)', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Image to Text (OCR)</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Image to Text (OCR)
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Extract accurate English, বাংলা &amp; handwritten text in 1–2 seconds — zero downloads.
      </p>
    </header>

    <OcrTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Accurate বাংলা &amp; English</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Reads complex Bengali conjuncts, mixed bilingual pages, angled street signs, and dark-background screenshots cleanly.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Instant 1–2 Second Results</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Zero heavy downloads—press Ctrl+V to paste any screenshot, edit the text, and copy or export .txt right away.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Handwriting &amp; Receipt Ready</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Switch to Handwriting mode for neat notebook pages, receipts, and printed tables with preserved line breaks.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/crop-image" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Crop &amp; Rotate</a>
          <a href="/pdf-to-jpg" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">PDF to JPG</a>
          <a href="/blur-image" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Privacy Blur</a>
          {SEO_PAGES.slice(0, 5).map((item) => (
            <a
              href={`/${item.slug}`}
              class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 hover:border-zinc-400 transition"
            >
              {item.shortName}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </article>
</Layout>
