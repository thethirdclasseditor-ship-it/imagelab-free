---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SignPdfTool from '../components/SignPdfTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelab-free.pages.dev';
const pageUrl = `${siteBase}/sign-pdf`;

const title = 'Sign PDF Free Online (No Limits, Private) | ImageLab';
const description =
  'Sign PDF contracts, agreements, and forms directly in your browser. Draw, type, or upload your signature, add date stamps, and download cleanly with zero uploads.';

const faqs = [
  {
    q: 'Is there a monthly limit on how many PDFs I can sign?',
    a: 'No. Unlike cloud e-signature tools that lock free accounts to 2 or 3 documents a month, ImageLab runs locally inside your browser so you can sign unlimited PDFs for free.',
  },
  {
    q: 'Can I upload a phone photo of my signature on white paper?',
    a: 'Yes. Switch to the Upload tab, select your signature photo, and keep "Auto-remove white paper background" enabled—ImageLab cleanly isolates your ink stroke before placing it on the document.',
  },
  {
    q: 'Does signing flatten or blur the text inside my PDF?',
    a: 'No. ImageLab embeds your signature directly onto the original PDF pages while keeping all existing vector text, links, and formatting sharp and selectable.',
  },
  {
    q: 'Are my signed contracts or personal signature uploaded anywhere?',
    a: 'Never. Both your PDF document and your signature stay 100% on your device from start to finish.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free Private PDF Signer',
  url: pageUrl,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'Sign PDF', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">Sign PDF</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        Sign PDF Online
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Draw, type, or upload your signature &amp; add date stamps locally — unlimited and 100% private.
      </p>
    </header>

    <SignPdfTool client:only="react">
      <div
        slot="fallback"
        class="studio-card rounded-3xl min-h-[420px] flex flex-col items-center justify-center gap-3 p-8 text-center"
      >
        <div class="w-8 h-8 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></div>
        <p class="text-xs font-semibold text-zinc-500">Loading PDF Signer...</p>
      </div>
    </SignPdfTool>

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Draw, Type or Upload Ink</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Sign smoothly with mouse or touch, generate cursive text, or auto-clean a photo of your handwritten signature.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Crisp Vector Text Preserved</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Drag and resize signatures across any page while keeping every word of the original PDF sharp and searchable.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Zero Uploads or Paywalls</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Sensitive NDAs, rental agreements, and HR forms stay strictly inside your browser with no monthly caps.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More PDF Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related PDF tools</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/organize-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Organize &amp; Rotate PDF</a>
          <a href="/merge-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Merge PDF</a>
          <a href="/compress-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Compress PDF</a>
          <a href="/split-pdf" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Split PDF</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
