---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import QrReaderTool from '../components/QrReaderTool';

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://imagelabkit.com';
const pageUrl = `${siteBase}/qr-code-reader`;

const title = 'Free Online QR Code Reader & Scanner (Image & Camera) | ImageLabKit';
const description =
  'Scan and decode QR codes from screenshots, uploaded photos (JPG, PNG, WEBP, SVG, HEIC), clipboard paste (Ctrl+V), or your live webcam/phone camera — 100% private inside your browser.';

const faqs = [
  {
    q: 'Can I scan a QR code from a screenshot without using a second phone?',
    a: 'Yes. Upload the image, drag and drop it onto the page, or simply press Ctrl+V (Cmd+V on Mac) to paste a screenshot straight from your clipboard and decode it instantly.',
  },
  {
    q: 'Is my webcam video or uploaded QR image sent to a server?',
    a: 'Never. Both live camera frame scanning and image decoding run 100% locally inside your browser tab using jsQR—no images or camera video ever leave your device.',
  },
  {
    q: 'Does it automatically open suspicious QR links?',
    a: 'No. ImageLabKit always displays the full destination URL and domain name first so you can inspect it safely before deciding whether to open or copy the link.',
  },
  {
    q: 'Can it read Wi-Fi passwords, Contact cards (vCard), and inverted QR codes?',
    a: 'Yes. It automatically parses Wi-Fi credentials (with 1-click password copy), vCard contacts (with .vcf download), email/phone actions, and supports both standard dark-on-light and inverted light-on-dark QR codes.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLabKit Free Online QR Code Reader & Scanner',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteBase },
    { '@type': 'ListItem', position: 2, name: 'QR Code Reader', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  schemas={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-7 sm:pt-11 pb-12">
    <nav aria-label="Breadcrumb" class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-zinc-700 font-medium">QR Code Reader</span>
    </nav>

    <header class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-[1.1]">
        QR Code Reader &amp; Scanner
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Scan QR codes from screenshots, photos, clipboard paste, or live camera — 100% locally in your browser.
      </p>
    </header>

    <QrReaderTool client:load />

    <div class="max-w-4xl mx-auto mt-16 space-y-10">
      <section class="grid sm:grid-cols-3 gap-4">
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Image, Clipboard &amp; Camera</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Upload JPG, PNG, WEBP, SVG, or iPhone HEIC photos, paste screenshots with Ctrl+V, or scan live with your camera.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Safe URL &amp; Smart Parsing</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            Inspect destination domains before clicking, copy Wi-Fi passwords cleanly, or save vCard contacts as .VCF files.
          </p>
        </div>
        <div class="studio-card rounded-2xl p-5">
          <h2 class="font-bold text-zinc-950 text-sm">Zero Server Uploads</h2>
          <p class="text-xs text-zinc-500 mt-1.5 leading-relaxed">
            All QR decoding runs strictly inside browser memory—private Wi-Fi codes and tickets never leave your device.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-bold text-zinc-950 mb-4">Questions</h2>
        <div class="divide-y divide-zinc-200/80 studio-card rounded-3xl overflow-hidden">
          {faqs.map((faq) => (
            <details class="group px-6 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-zinc-900 cursor-pointer list-none">
                <span>{faq.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  class="w-4 h-4 text-zinc-400 shrink-0 group-open:rotate-180 transition-transform duration-200"
                  aria-hidden="true"
                />
              </summary>
              <p class="text-xs sm:text-[13.5px] text-zinc-500 mt-2.5 leading-relaxed pr-6">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="More Graphics Tools" class="pt-4">
        <h2 class="text-sm font-bold text-zinc-900 mb-3">Related tools &amp; guides</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/qr-code-generator" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">QR Code Generator</a>
          <a href="/barcode-generator" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Barcode Generator</a>
          <a href="/image-to-text" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">Image to Text (OCR)</a>
          <a href="/exif-remover" class="px-3.5 py-2 rounded-xl bg-white border border-zinc-200/90 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition">EXIF Remover</a>
          <a href="/guides/static-vs-dynamic-qr-codes-print-guide" class="px-3.5 py-2 rounded-xl bg-blue-500/8 border border-blue-500/20 text-xs font-semibold text-blue-700 dark:text-blue-400 transition">Static vs Dynamic QR Guide →</a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
