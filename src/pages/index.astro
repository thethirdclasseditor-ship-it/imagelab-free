---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import ToolWorkspace from '../components/ToolWorkspace';
import { SEO_PAGES } from '../data/seoPages';
import { getToolStatus } from '../config/tools';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLabKit — Free Online Image, PDF & Graphics Studio',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Fast browser image converter, compressor, image merger (NID front-back A4), passport photo print sheet maker, visual cropper, privacy blur, EXIF remover, Bangla & English OCR, word counter, text compare, QR code generator & scanner, barcode generator, and full PDF suite on ImageLabKit.',
};

interface ToolCard {
  href: string;
  title: string;
  desc: string;
  tag: string;
  icon: string;
  keywords: string;
  soon?: boolean;
}

const popularTools = [
  { href: '/merge-pdf', title: 'Merge PDF', sub: 'Combine PDFs', icon: 'lucide:layers' },
  { href: '/compress-pdf', title: 'Compress PDF', sub: 'Shrink PDF size', icon: 'lucide:minimize-2' },
  { href: '/image-to-pdf', title: 'Image to PDF', sub: 'Photos to A4 PDF', icon: 'lucide:file-text' },
  { href: '/image-to-text', title: 'Image to Text', sub: 'English & বাংলা OCR', icon: 'lucide:scan-text' },
  { href: '/compress-image-to-50kb', title: 'Compress 50KB', sub: 'Portal upload limit', icon: 'lucide:gauge' },
  { href: '/qr-code-generator', title: 'QR Generator', sub: 'Static SVG / PNG', icon: 'lucide:qr-code' },
];

const rawPdfStudioTools: ToolCard[] = [
  {
    href: '/merge-pdf',
    title: 'Merge PDF',
    desc: 'Combine up to 25 PDFs in exact order.',
    tag: 'Most Used',
    icon: 'lucide:layers',
    keywords: 'combine join pdf files merge',
  },
  {
    href: '/compress-pdf',
    title: 'Compress PDF',
    desc: 'Shrink scanned or photo-heavy PDFs.',
    tag: 'Shrink Size',
    icon: 'lucide:minimize-2',
    keywords: 'reduce pdf size optimize kb mb compress',
  },
  {
    href: '/image-to-pdf',
    title: 'Image to PDF',
    desc: 'Merge up to 30 photos into clean A4.',
    tag: 'Document',
    icon: 'lucide:file-text',
    keywords: 'jpg png photo to pdf a4 convert',
  },
  {
    href: '/pdf-to-jpg',
    title: 'PDF to JPG',
    desc: 'Render PDF pages to crisp HD images.',
    tag: 'HD Export',
    icon: 'lucide:image',
    keywords: 'pdf to image png jpg extract pages',
  },
  {
    href: '/split-pdf',
    title: 'Split & Extract PDF',
    desc: 'Extract page ranges or burst to ZIP.',
    tag: 'Extract',
    icon: 'lucide:scissors',
    keywords: 'cut separate remove pdf pages split',
  },
  {
    href: '/add-page-numbers-pdf',
    title: 'Add Page Numbers',
    desc: 'Stamp clean vector numbers, skip cover & mirror.',
    tag: 'New',
    icon: 'lucide:hash',
    keywords: 'number pdf pages thesis report assignment header footer',
  },
  {
    href: '/pdf-to-text',
    title: 'PDF to Text',
    desc: 'Extract clean text from digital PDFs to .TXT & .MD.',
    tag: 'New',
    icon: 'lucide:file-text',
    keywords: 'extract copy text from pdf txt markdown',
  },
  {
    href: '/sign-pdf',
    title: 'Sign PDF',
    desc: 'Draw, type or upload signature & date stamp.',
    tag: 'Unlimited',
    icon: 'lucide:pen-tool',
    keywords: 'esign signature stamp document pdf',
  },
  {
    href: '/organize-pdf',
    title: 'Organize & Rotate PDF',
    desc: 'Reorder, rotate 90°, delete & watermark pages.',
    tag: 'Pages',
    icon: 'lucide:layout-grid',
    keywords: 'rearrange sort rotate delete watermark pdf',
  },
];

const rawImageStudioTools: ToolCard[] = [
  {
    href: '/image-to-text',
    title: 'Image to Text (OCR)',
    desc: 'Extract English, বাংলা & handwritten text.',
    tag: 'Smart AI',
    icon: 'lucide:scan-text',
    keywords: 'ocr bangla bengali english photo to text scan handwriting',
  },
  {
    href: '/merge-images',
    title: 'Merge Images (NID A4)',
    desc: 'Side-by-side, vertical, grid & NID front-back A4.',
    tag: 'New',
    icon: 'lucide:image-plus',
    keywords: 'combine join photos side by side nid id card front back a4 collage',
  },
  {
    href: '/passport-photo-sheet',
    title: 'Passport Photo Print Sheet',
    desc: '300 DPI A4 & 4×6 printable sheets with cut guides.',
    tag: 'New',
    icon: 'lucide:printer',
    keywords: 'passport stamp photo sheet 4x6 a4 print bd 40x50 visa 300dpi',
  },
  {
    href: '/crop-image',
    title: 'Visual Crop & Rotate',
    desc: 'Exact aspect ratios, flip & framing guides.',
    tag: 'Editor',
    icon: 'lucide:crop',
    keywords: 'trim cut aspect ratio rotate flip photo',
  },
  {
    href: '/word-counter',
    title: 'Word & Character Counter',
    desc: 'Live count, reading time, case & text cleaner.',
    tag: 'English & বাংলা',
    icon: 'lucide:file-text',
    keywords: 'count words characters bangla seo limit uppercase lowercase',
  },
  {
    href: '/text-compare',
    title: 'Text Compare (Diff)',
    desc: 'Compare two drafts or code blocks side-by-side.',
    tag: 'New',
    icon: 'lucide:arrow-left-right',
    keywords: 'diff checker compare text bangla code changes highlight',
  },
  {
    href: '/watermark-image',
    title: 'Batch Watermark',
    desc: 'Text, PNG logos & diagonal tiled stamps.',
    tag: 'Batch',
    icon: 'lucide:stamp',
    keywords: 'logo copyright text stamp watermark photo',
  },
  {
    href: '/blur-image',
    title: 'Privacy Blur & Redact',
    desc: 'Pixelate, blur, or blackout faces & IDs.',
    tag: 'Privacy',
    icon: 'lucide:eye-off',
    keywords: 'censor hide face nid sensitive pixelate redact',
  },
  {
    href: '/exif-remover',
    title: 'EXIF Metadata Remover',
    desc: 'Inspect & strip hidden GPS and camera tags.',
    tag: 'Privacy',
    icon: 'lucide:shield-check',
    keywords: 'remove location gps camera info metadata exif',
  },
  {
    href: '/remove-background',
    title: 'AI Background Remover',
    desc: 'Instant studio-grade transparent cutouts.',
    tag: 'Coming Soon',
    icon: 'lucide:sparkles',
    keywords: 'bg remove transparent cutout background',
  },
  {
    href: '/photo-enhancer',
    title: 'AI Photo Enhancer',
    desc: 'Fast HD detail & lighting restoration.',
    tag: 'Coming Soon',
    icon: 'lucide:sliders-horizontal',
    keywords: 'upscale enhance hd sharpen restore photo',
  },
];

const rawGraphicsTools: ToolCard[] = [
  {
    href: '/qr-code-generator',
    title: 'QR Code Generator',
    desc: 'Static SVG/PNG with logo, Wi-Fi & WhatsApp — never expires.',
    tag: 'Vector SVG',
    icon: 'lucide:qr-code',
    keywords: 'qr wifi whatsapp vcard link logo svg png create make',
  },
  {
    href: '/qr-code-reader',
    title: 'QR Code Reader & Scanner',
    desc: 'Decode QR codes from images, Ctrl+V screenshots or live camera.',
    tag: 'New',
    icon: 'lucide:scan-line',
    keywords: 'qr scan read decode camera screenshot image wifi link scanner reader',
  },
  {
    href: '/color-picker',
    title: 'Color Palette Extractor',
    desc: 'Extract brand palettes & pick exact HEX, RGB, HSL codes.',
    tag: 'Eyedropper',
    icon: 'lucide:palette',
    keywords: 'hex rgb hsl css color eyedropper palette image',
  },
  {
    href: '/barcode-generator',
    title: 'Barcode Generator',
    desc: 'Code 128, EAN-13, UPC-A & bulk 100-SKU ZIP export.',
    tag: 'Bulk ZIP',
    icon: 'lucide:barcode',
    keywords: 'ean13 upc code128 sku label product barcode',
  },
  {
    href: '/svg-to-png',
    title: 'SVG to PNG',
    desc: 'Render crisp vector logos up to 4096px PNG, WEBP or JPG.',
    tag: 'HD Export',
    icon: 'lucide:file-code-2',
    keywords: 'vector svg convert png jpg webp high res',
  },
  {
    href: '/favicon-generator',
    title: 'Favicon & ICO Generator',
    desc: 'Multi-size favicon.ico, Apple Touch & Android icon pack.',
    tag: 'Web Pack',
    icon: 'lucide:globe',
    keywords: 'ico apple touch pwa website icon favicon',
  },
];

function applyStatus(list: ToolCard[]): ToolCard[] {
  return list
    .filter((item) => getToolStatus(item.href) !== 'hidden')
    .map((item) => {
      const status = getToolStatus(item.href);
      return {
        ...item,
        soon: status === 'soon',
        tag: status === 'soon' ? 'Coming Soon' : item.tag,
      };
    });
}

const pdfStudioTools = applyStatus(rawPdfStudioTools);
const imageStudioTools = applyStatus(rawImageStudioTools);
const graphicsTools = applyStatus(rawGraphicsTools);

const categories = [
  { id: 'Compress', icon: 'lucide:minimize-2' },
  { id: 'Convert', icon: 'lucide:refresh-cw' },
  { id: 'Resize', icon: 'lucide:maximize-2' },
  { id: 'Enhance', icon: 'lucide:sparkles' },
] as const;

function getPresetIcon(slug: string, cat: string): string {
  if (slug.includes('heic')) return 'lucide:smartphone';
  if (slug.includes('avif')) return 'lucide:globe';
  if (slug.includes('webp')) return 'lucide:zap';
  if (slug.includes('signature')) return 'lucide:pen-tool';
  if (slug.includes('passport')) return 'lucide:user-check';
  if (slug.includes('300x300')) return 'lucide:user';
  if (slug.includes('youtube')) return 'lucide:monitor';
  if (slug.includes('brighten')) return 'lucide:sun';
  if (slug.includes('enhance')) return 'lucide:sparkles';
  if (cat === 'Compress') return 'lucide:gauge';
  if (cat === 'Convert') return 'lucide:refresh-cw';
  if (cat === 'Resize') return 'lucide:maximize-2';
  return 'lucide:image';
}

const filterTabs = [
  { id: 'all', label: 'All Tools' },
  { id: 'pdf', label: 'PDF Suite' },
  { id: 'studio', label: 'Image & Text' },
  { id: 'graphics', label: 'Graphics' },
  { id: 'presets', label: 'Quick Presets' },
] as const;
---

<Layout
  title="ImageLabKit — Free Online Image, PDF & Graphics Studio"
  description="Convert HEIC, AVIF, JPG, PNG, WEBP, SVG to PNG, compress to target KB, merge NID front-back A4, make 300 DPI passport photo sheets, extract Bangla & English text (OCR), compare text, create & scan QR codes, and merge, compress, number or sign PDFs privately on ImageLabKit."
  schemas={[homeSchema]}
>
  <!-- Hero & Primary Studio -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-6">
    <div class="text-center max-w-2xl mx-auto mb-8 animate-fade-up">
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-zinc-950 leading-[1.08]">
        Image &amp; PDF Studio.
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Convert, compress, design graphics &amp; edit PDFs on ImageLabKit — free, instant, and private.
      </p>
    </div>

    <ToolWorkspace client:load initialMode="converter" showModeTabs={true} />
  </section>

  <!-- Instant Search & Category Filter Bar -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-2">
    <div class="studio-card rounded-3xl p-3 sm:p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 max-w-xl">
        <Icon
          name="lucide:search"
          class="w-4 h-4 text-zinc-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
          aria-hidden="true"
        />
        <input
          id="tool-search-input"
          type="search"
          autocomplete="off"
          placeholder="Search tools: merge pdf, nid, passport, 50kb, ocr, qr..."
          aria-label="Search tools"
          class="w-full pl-10 pr-9 py-2.5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/70 text-xs sm:text-sm text-zinc-950 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500 transition"
        />
        <button
          id="tool-search-clear"
          type="button"
          aria-label="Clear search"
          class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 w-6 h-6 rounded-lg text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-200/70 dark:hover:bg-zinc-800 items-center justify-center cursor-pointer"
        >
          <Icon name="lucide:x" class="w-3.5 h-3.5" aria-hidden="true" />
        </button>
      </div>

      <!-- Category Filter Pills -->
      <div
        id="tool-filter-pills"
        role="tablist"
        aria-label="Filter tool categories"
        class="flex items-center gap-1.5 overflow-x-auto pb-0.5 lg:pb-0"
      >
        {filterTabs.map((tab, idx) => (
          <button
            type="button"
            role="tab"
            data-filter-cat={tab.id}
            aria-selected={idx === 0 ? 'true' : 'false'}
            class={`filter-pill shrink-0 px-3.5 py-2 rounded-xl text-xs font-semibold border transition cursor-pointer ${
              idx === 0
                ? 'bg-blue-600 text-white border-blue-600 shadow-sm'
                : 'bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-300 hover:border-blue-500/50 hover:text-zinc-950 dark:hover:text-white'
            }`}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Most Popular Quick Row (hidden when actively searching or filtering a single category) -->
  <section id="popular-section" class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-4">
    <div class="flex items-center gap-2 mb-4">
      <Icon name="lucide:flame" class="w-4 h-4 text-blue-600 dark:text-blue-400" aria-hidden="true" />
      <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-500">Most Popular</h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {popularTools.map((tool) => (
        <a
          href={tool.href}
          class="group studio-card rounded-2xl p-3.5 hover:-translate-y-0.5 hover:border-blue-500/40 transition-all flex items-center gap-3"
        >
          <span class="w-9 h-9 rounded-xl bg-blue-600/10 text-blue-600 dark:text-blue-400 group-hover:bg-blue-600 group-hover:text-white flex items-center justify-center shrink-0 transition-colors">
            <Icon name={tool.icon} class="w-4 h-4" aria-hidden="true" />
          </span>
          <div class="min-w-0">
            <div class="text-xs font-bold text-zinc-950 group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate transition">
              {tool.title}
            </div>
            <div class="text-[11px] text-zinc-500 truncate">{tool.sub}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- No Search Results Fallback -->
  <section id="no-results-box" class="hidden max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="studio-card rounded-3xl p-8 text-center space-y-3">
      <p class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
        No matching tools found
      </p>
      <p class="text-xs text-zinc-500">
        Try searching with simpler keywords like "pdf", "compress", "passport", "nid", "ocr", or "qr".
      </p>
      <button
        id="reset-search-btn"
        type="button"
        class="btn-studio-primary px-4 py-2 rounded-xl text-xs font-semibold cursor-pointer"
      >
        Show All Tools
      </button>
    </div>
  </section>

  <!-- 1. PDF Suite Grid (Highest Demand First) -->
  <section data-section-cat="pdf" class="directory-section max-w-6xl mx-auto px-4 sm:px-6 py-7">
    <div class="mb-5">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-950">PDF Suite</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {pdfStudioTools.map((tool) => (
        <a
          href={tool.href}
          data-search={`${tool.title} ${tool.desc} ${tool.tag} ${tool.keywords} pdf`.toLowerCase()}
          class="tool-item group studio-card rounded-2xl p-5 hover:-translate-y-0.5 hover:border-blue-500/40 transition-all duration-200 flex flex-col justify-between gap-5"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 flex items-center justify-center transition-colors">
              <Icon name={tool.icon} class="w-5 h-5" aria-hidden="true" />
            </div>

            <span
              class={`px-2.5 py-1 rounded-lg text-[11px] font-semibold ${
                tool.tag === 'New' || tool.tag === 'Most Used'
                  ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400'
                  : 'bg-zinc-100 text-zinc-600'
              }`}
            >
              {tool.tag}
            </span>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-bold text-zinc-950 text-[15.5px] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                {tool.title}
              </h3>
              <Icon
                name="lucide:arrow-right"
                class="w-4 h-4 text-zinc-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all"
                aria-hidden="true"
              />
            </div>
            <p class="text-xs sm:text-[13px] text-zinc-500 mt-1">{tool.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 2. Image & Text Studio Grid -->
  <section data-section-cat="studio" class="directory-section max-w-6xl mx-auto px-4 sm:px-6 py-7">
    <div class="mb-5">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-950">Image &amp; Text Studio</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {imageStudioTools.map((tool) => (
        <a
          href={tool.href}
          data-search={`${tool.title} ${tool.desc} ${tool.tag} ${tool.keywords} image text studio`.toLowerCase()}
          class={`tool-item group studio-card rounded-2xl p-5 transition-all duration-200 flex flex-col justify-between gap-5 ${
            tool.soon
              ? 'opacity-75 hover:opacity-95 border-dashed'
              : 'hover:-translate-y-0.5 hover:border-blue-500/40'
          }`}
        >
          <div class="flex items-start justify-between gap-3">
            <div
              class={`w-10 h-10 rounded-xl border flex items-center justify-center transition-colors ${
                tool.soon
                  ? 'bg-zinc-100 border-zinc-200/80 text-zinc-500'
                  : 'bg-zinc-100 border-zinc-200/80 text-zinc-800 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600'
              }`}
            >
              <Icon name={tool.icon} class="w-5 h-5" aria-hidden="true" />
            </div>

            <span
              class={`px-2.5 py-1 rounded-lg text-[11px] font-semibold ${
                tool.soon
                  ? 'bg-amber-500/15 text-amber-700 dark:text-amber-300'
                  : tool.tag === 'New' || tool.tag === 'Smart AI'
                  ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400'
                  : 'bg-zinc-100 text-zinc-600'
              }`}
            >
              {tool.tag}
            </span>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-bold text-zinc-950 text-[15.5px] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                {tool.title}
              </h3>
              <Icon
                name="lucide:arrow-right"
                class="w-4 h-4 text-zinc-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all"
                aria-hidden="true"
              />
            </div>
            <p class="text-xs sm:text-[13px] text-zinc-500 mt-1">{tool.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Graphics & Generators Grid -->
  <section data-section-cat="graphics" class="directory-section max-w-6xl mx-auto px-4 sm:px-6 py-7">
    <div class="mb-5">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-950">Graphics &amp; Generators</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {graphicsTools.map((tool) => (
        <a
          href={tool.href}
          data-search={`${tool.title} ${tool.desc} ${tool.tag} ${tool.keywords} graphics`.toLowerCase()}
          class="tool-item group studio-card rounded-2xl p-5 hover:-translate-y-0.5 hover:border-blue-500/40 transition-all duration-200 flex flex-col justify-between gap-5"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 flex items-center justify-center transition-colors">
              <Icon name={tool.icon} class="w-5 h-5" aria-hidden="true" />
            </div>

            <span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[11px] font-semibold">
              {tool.tag}
            </span>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-bold text-zinc-950 text-[15.5px] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                {tool.title}
              </h3>
              <Icon
                name="lucide:arrow-right"
                class="w-4 h-4 text-zinc-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all"
                aria-hidden="true"
              />
            </div>
            <p class="text-xs sm:text-[13px] text-zinc-500 mt-1">{tool.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. Quick Presets Index with Leading Icons -->
  <section data-section-cat="presets" class="directory-section max-w-6xl mx-auto px-4 sm:px-6 py-7">
    <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 mb-5">Quick Presets</h2>

    <div class="studio-card rounded-3xl p-6 sm:p-7 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.map((cat) => (
        <div class="preset-group">
          <h3 class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-zinc-400 mb-3">
            <Icon name={cat.icon} class="w-3.5 h-3.5 text-zinc-400" aria-hidden="true" />
            <span>{cat.id}</span>
          </h3>
          <div class="flex flex-col gap-1">
            {SEO_PAGES.filter((p) => p.category === cat.id).map((page) => (
              <a
                href={`/${page.slug}`}
                data-search={`${page.shortName} ${page.h1} ${page.slug.replace(/-/g, ' ')} ${cat.id} preset`.toLowerCase()}
                class="preset-item group flex items-center justify-between gap-2 py-1.5 px-2.5 -mx-2.5 rounded-xl text-[13px] font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950 transition"
              >
                <span class="flex items-center gap-2 min-w-0">
                  <Icon
                    name={getPresetIcon(page.slug, cat.id)}
                    class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 shrink-0 transition-colors"
                    aria-hidden="true"
                  />
                  <span class="truncate">{page.shortName}</span>
                </span>
                <Icon
                  name="lucide:arrow-right"
                  class="w-3.5 h-3.5 opacity-0 group-hover:opacity-60 shrink-0 transition"
                  aria-hidden="true"
                />
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Architectural Spec Strip -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-4">
    <div class="grid sm:grid-cols-3 gap-6 border-t border-zinc-200/80 pt-10">
      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <Icon name="lucide:sparkles" class="w-4 h-4" aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">Studio-Grade Quality</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Smart compression and crisp image, vector &amp; PDF exports without visible quality loss.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <Icon name="lucide:lock" class="w-4 h-4" aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">Private By Design</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Core image, graphic &amp; PDF tools run locally on your device with zero file storage.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <Icon name="lucide:zap" class="w-4 h-4" aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">Instant Batch &amp; ZIP</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Process up to 100 barcodes, 25 PDFs, or 20 images at once with zero daily limits.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Zero-Overhead Instant Search & Category Filter Script -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById('tool-search-input');
      const clearBtn = document.getElementById('tool-search-clear');
      const resetBtn = document.getElementById('reset-search-btn');
      const pills = Array.from(document.querySelectorAll('.filter-pill'));
      const sections = Array.from(document.querySelectorAll('.directory-section'));
      const popularSection = document.getElementById('popular-section');
      const noResultsBox = document.getElementById('no-results-box');

      if (!searchInput || sections.length === 0) return;

      let activeCat = 'all';

      function updatePillStyles() {
        pills.forEach(function (pill) {
          const isActive = pill.getAttribute('data-filter-cat') === activeCat;
          pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
          if (isActive) {
            pill.classList.add('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-sm');
            pill.classList.remove(
              'bg-white',
              'dark:bg-zinc-900',
              'border-zinc-200',
              'dark:border-zinc-800',
              'text-zinc-600',
              'dark:text-zinc-300'
            );
          } else {
            pill.classList.remove('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-sm');
            pill.classList.add(
              'bg-white',
              'dark:bg-zinc-900',
              'border-zinc-200',
              'dark:border-zinc-800',
              'text-zinc-600',
              'dark:text-zinc-300'
            );
          }
        });
      }

      function applyFilter() {
        const q = (searchInput.value || '').trim().toLowerCase();
        const isSearching = q.length > 0;
        const terms = isSearching ? q.split(/\s+/).filter(Boolean) : [];

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', !isSearching);
          clearBtn.classList.toggle('flex', isSearching);
        }

        if (popularSection) {
          popularSection.classList.toggle('hidden', isSearching || activeCat !== 'all');
        }

        let totalVisible = 0;

        sections.forEach(function (sec) {
          const secCat = sec.getAttribute('data-section-cat');
          const catMatch = activeCat === 'all' || activeCat === secCat;

          if (!catMatch) {
            sec.classList.add('hidden');
            return;
          }

          if (secCat === 'presets') {
            let sectionVisible = 0;
            sec.querySelectorAll('.preset-group').forEach(function (group) {
              let groupVisible = 0;
              group.querySelectorAll('.preset-item').forEach(function (item) {
                const hay = item.getAttribute('data-search') || '';
                const matched = !isSearching || terms.every(function (t) { return hay.includes(t); });
                item.classList.toggle('hidden', !matched);
                if (matched) groupVisible++;
              });
              group.classList.toggle('hidden', groupVisible === 0);
              sectionVisible += groupVisible;
            });
            sec.classList.toggle('hidden', sectionVisible === 0);
            totalVisible += sectionVisible;
          } else {
            let sectionVisible = 0;
            sec.querySelectorAll('.tool-item').forEach(function (item) {
              const hay = item.getAttribute('data-search') || '';
              const matched = !isSearching || terms.every(function (t) { return hay.includes(t); });
              item.classList.toggle('hidden', !matched);
              if (matched) sectionVisible++;
            });
            sec.classList.toggle('hidden', sectionVisible === 0);
            totalVisible += sectionVisible;
          }
        });

        if (noResultsBox) {
          noResultsBox.classList.toggle('hidden', totalVisible > 0);
        }
      }

      searchInput.addEventListener('input', applyFilter);

      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          activeCat = pill.getAttribute('data-filter-cat') || 'all';
          updatePillStyles();
          applyFilter();
        });
      });

      function resetAll() {
        searchInput.value = '';
        activeCat = 'all';
        updatePillStyles();
        applyFilter();
        searchInput.focus();
      }

      if (clearBtn) clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        applyFilter();
        searchInput.focus();
      });

      if (resetBtn) resetBtn.addEventListener('click', resetAll);
    })();
  </script>
</Layout>
