---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import ToolWorkspace from '../components/ToolWorkspace';
import { SEO_PAGES } from '../data/seoPages';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free Online Image & PDF Studio',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Fast browser image converter, compressor, visual cropper, privacy blur, EXIF remover, Bangla & English OCR, watermark studio, and full PDF suite.',
};

const imageStudioTools = [
  {
    href: '/image-to-text',
    title: 'Image to Text (OCR)',
    desc: 'Extract English, বাংলা & handwritten text.',
    tag: 'Smart AI',
    icon: 'lucide:scan-text',
    soon: false,
  },
  {
    href: '/crop-image',
    title: 'Visual Crop & Rotate',
    desc: 'Exact aspect ratios & framing guides.',
    tag: 'Editor',
    icon: 'lucide:crop',
    soon: false,
  },
  {
    href: '/blur-image',
    title: 'Privacy Blur & Redact',
    desc: 'Pixelate, blur, or blackout faces & IDs.',
    tag: 'Privacy',
    icon: 'lucide:eye-off',
    soon: false,
  },
  {
    href: '/exif-remover',
    title: 'EXIF Metadata Remover',
    desc: 'Inspect & strip GPS and camera tags.',
    tag: 'Privacy',
    icon: 'lucide:shield-check',
    soon: false,
  },
  {
    href: '/watermark-image',
    title: 'Batch Watermark',
    desc: 'Text, PNG logos & diagonal tiles.',
    tag: 'Batch',
    icon: 'lucide:stamp',
    soon: false,
  },
  {
    href: '/remove-background',
    title: 'AI Background Remover',
    desc: 'Upgrading to instant studio-grade cutouts.',
    tag: 'Coming Soon',
    icon: 'lucide:sparkles',
    soon: true,
  },
  {
    href: '/photo-enhancer',
    title: 'AI Photo Enhancer',
    desc: 'Upgrading to fast HD detail restoration.',
    tag: 'Coming Soon',
    icon: 'lucide:sliders-horizontal',
    soon: true,
  },
];

const pdfStudioTools = [
  {
    href: '/merge-pdf',
    title: 'Merge PDF',
    desc: 'Combine up to 25 PDFs in exact order.',
    tag: 'Lossless',
    icon: 'lucide:layers',
  },
  {
    href: '/split-pdf',
    title: 'Split & Extract PDF',
    desc: 'Extract page ranges or burst to ZIP.',
    tag: 'Pages',
    icon: 'lucide:scissors',
  },
  {
    href: '/compress-pdf',
    title: 'Compress PDF',
    desc: 'Shrink scanned or photo-heavy PDFs.',
    tag: 'Shrink Size',
    icon: 'lucide:minimize-2',
  },
  {
    href: '/pdf-to-jpg',
    title: 'PDF to JPG',
    desc: 'Render PDF pages to crisp HD images.',
    tag: 'HD Export',
    icon: 'lucide:image',
  },
  {
    href: '/image-to-pdf',
    title: 'Image to PDF',
    desc: 'Merge up to 30 photos into clean A4.',
    tag: 'Document',
    icon: 'lucide:file-text',
  },
];

const categories = [
  { id: 'Compress', icon: 'lucide:minimize-2' },
  { id: 'Convert', icon: 'lucide:refresh-cw' },
  { id: 'Resize', icon: 'lucide:maximize-2' },
  { id: 'Enhance', icon: 'lucide:sparkles' },
] as const;

function getPresetIcon(slug: string, cat: string): string {
  if (slug.includes('heic')) return 'lucide:smartphone';
  if (slug.includes('avif')) return 'lucide:globe';
  if (slug.includes('webp')) return 'lucide:zap';
  if (slug.includes('signature')) return 'lucide:pen-tool';
  if (slug.includes('passport')) return 'lucide:user-check';
  if (slug.includes('300x300')) return 'lucide:user';
  if (slug.includes('youtube')) return 'lucide:monitor';
  if (slug.includes('brighten')) return 'lucide:sun';
  if (slug.includes('enhance')) return 'lucide:sparkles';
  if (cat === 'Compress') return 'lucide:gauge';
  if (cat === 'Convert') return 'lucide:refresh-cw';
  if (cat === 'Resize') return 'lucide:maximize-2';
  return 'lucide:image';
}
---

<Layout
  title="ImageLab — Free Online Image & PDF Studio"
  description="Convert HEIC, AVIF, JPG, PNG, WEBP, compress to target KB, crop visually, extract Bangla & English text (OCR), blur faces, remove EXIF, watermark, and manage PDFs privately."
  schemas={[homeSchema]}
>
  <!-- Hero & Primary Studio -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-8">
    <div class="text-center max-w-2xl mx-auto mb-8 animate-fade-up">
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-zinc-950 leading-[1.08]">
        Image &amp; PDF Studio.
      </h1>
      <p class="text-zinc-500 mt-3 text-sm sm:text-base font-medium">
        Convert, compress, edit images &amp; PDFs — free, instant, and private.
      </p>
    </div>

    <ToolWorkspace client:load initialMode="converter" showModeTabs={true} />
  </section>

  <!-- Image Studio Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-950">Image Studio</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {imageStudioTools.map((tool) => (
        <a
          href={tool.href}
          class={`group studio-card rounded-2xl p-5 transition-all duration-200 flex flex-col justify-between gap-5 ${
            tool.soon
              ? 'opacity-75 hover:opacity-95 border-dashed'
              : 'hover:-translate-y-0.5 hover:border-blue-500/40'
          }`}
        >
          <div class="flex items-start justify-between gap-3">
            <div
              class={`w-10 h-10 rounded-xl border flex items-center justify-center transition-colors ${
                tool.soon
                  ? 'bg-zinc-100 border-zinc-200/80 text-zinc-500'
                  : 'bg-zinc-100 border-zinc-200/80 text-zinc-800 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600'
              }`}
            >
              <Icon name={tool.icon} class="w-5 h-5" aria-hidden="true" />
            </div>

            <span
              class={`px-2.5 py-1 rounded-lg text-[11px] font-semibold ${
                tool.soon
                  ? 'bg-amber-500/15 text-amber-700 dark:text-amber-300'
                  : 'bg-zinc-100 text-zinc-600'
              }`}
            >
              {tool.tag}
            </span>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-bold text-zinc-950 text-[15.5px] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                {tool.title}
              </h3>
              <Icon
                name="lucide:arrow-right"
                class="w-4 h-4 text-zinc-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all"
                aria-hidden="true"
              />
            </div>
            <p class="text-xs sm:text-[13px] text-zinc-500 mt-1">{tool.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Browser-Native PDF Suite Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-950">PDF Suite</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {pdfStudioTools.map((tool) => (
        <a
          href={tool.href}
          class="group studio-card rounded-2xl p-5 hover:-translate-y-0.5 hover:border-blue-500/40 transition-all duration-200 flex flex-col justify-between gap-5"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 flex items-center justify-center transition-colors">
              <Icon name={tool.icon} class="w-5 h-5" aria-hidden="true" />
            </div>

            <span class="px-2.5 py-1 rounded-lg bg-zinc-100 text-zinc-600 text-[11px] font-semibold">
              {tool.tag}
            </span>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-bold text-zinc-950 text-[15.5px] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                {tool.title}
              </h3>
              <Icon
                name="lucide:arrow-right"
                class="w-4 h-4 text-zinc-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all"
                aria-hidden="true"
              />
            </div>
            <p class="text-xs sm:text-[13px] text-zinc-500 mt-1">{tool.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Quick Presets Index with Leading Icons -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 mb-6">Quick Presets</h2>

    <div class="studio-card rounded-3xl p-6 sm:p-7 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.map((cat) => (
        <div>
          <h3 class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-zinc-400 mb-3">
            <Icon name={cat.icon} class="w-3.5 h-3.5 text-zinc-400" aria-hidden="true" />
            <span>{cat.id}</span>
          </h3>
          <div class="flex flex-col gap-1">
            {SEO_PAGES.filter((p) => p.category === cat.id).map((page) => (
              <a
                href={`/${page.slug}`}
                class="group flex items-center justify-between gap-2 py-1.5 px-2.5 -mx-2.5 rounded-xl text-[13px] font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950 transition"
              >
                <span class="flex items-center gap-2 min-w-0">
                  <Icon
                    name={getPresetIcon(page.slug, cat.id)}
                    class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 shrink-0 transition-colors"
                    aria-hidden="true"
                  />
                  <span class="truncate">{page.shortName}</span>
                </span>
                <Icon
                  name="lucide:arrow-right"
                  class="w-3.5 h-3.5 opacity-0 group-hover:opacity-60 shrink-0 transition"
                  aria-hidden="true"
                />
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Architectural Spec Strip -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-4">
    <div class="grid sm:grid-cols-3 gap-6 border-t border-zinc-200/80 pt-10">
      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <Icon name="lucide:sparkles" class="w-4 h-4" aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">Studio-Grade Quality</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Smart compression and crisp image &amp; PDF exports without visible quality loss.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <Icon name="lucide:lock" class="w-4 h-4" aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">Private By Design</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Core image &amp; PDF tools run locally on your device with zero file storage.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <Icon name="lucide:zap" class="w-4 h-4" aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">Instant Batch &amp; ZIP</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Process up to 25 PDFs or 20 images at once with zero daily limits.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
