---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ImageLab — Free Online Image Tools (100% Private)</title>
    <meta
      name="description"
      content="Free browser-based image converter, compressor, resizer, and enhancer. Zero server uploads."
    />
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex items-center justify-center p-6">
    <main class="max-w-xl w-full bg-white rounded-2xl shadow-sm border border-slate-200 p-8 text-center">
      <span class="inline-block px-3 py-1 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-full mb-4">
        100% Free & Private
      </span>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">
        ImageLab AI is Live!
      </h1>
      <p class="text-slate-600 mt-3">
        আমাদের Step 1 সফল হয়েছে। এখন আমরা পরের ধাপে Image Engine এবং টুলগুলো যোগ করব।
      </p>
    </main>
  </body>
</html>
