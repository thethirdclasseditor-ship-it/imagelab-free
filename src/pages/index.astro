---
import Layout from '../layouts/Layout.astro';
import ToolWorkspace from '../components/ToolWorkspace';
import { SEO_PAGES } from '../data/seoPages';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free Online Image & PDF Studio',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Browser-native image converter, compressor, visual cropper, watermark studio, AI background remover, and PDF creator.',
};

const studioTools = [
  {
    href: '/remove-background',
    title: 'AI Background Remover',
    desc: 'HD cutouts & 300×300 portrait exports.',
    tag: 'On-Device AI',
    icon: 'sparkles',
  },
  {
    href: '/crop-image',
    title: 'Visual Crop & Rotate',
    desc: 'Exact aspect ratios & framing guides.',
    tag: 'Editor',
    icon: 'crop',
  },
  {
    href: '/photo-enhancer',
    title: 'AI Photo Enhancer',
    desc: 'Neural super-resolution & clarity.',
    tag: 'WebGPU AI',
    icon: 'sliders',
  },
  {
    href: '/image-to-pdf',
    title: 'Image to PDF',
    desc: 'Merge up to 30 photos into clean A4.',
    tag: 'Document',
    icon: 'file',
  },
  {
    href: '/watermark-image',
    title: 'Batch Watermark',
    desc: 'Text, PNG logos & diagonal tiles.',
    tag: 'Batch',
    icon: 'stamp',
  },
];

const categories = ['Compress', 'Convert', 'Resize', 'Enhance'] as const;
---

<Layout
  title="ImageLab — Browser Image & PDF Studio"
  description="Convert JPG, PNG, WEBP, HEIC, compress to target KB, crop visually, remove backgrounds with AI, watermark, and create PDFs locally. 100% free."
  schemas={[homeSchema]}
>
  <!-- Hero & Primary Studio -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 pb-8">
    <div class="text-center max-w-2xl mx-auto mb-9 animate-fade-up">
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-zinc-950 leading-[1.08]">
        Image & PDF Studio.
      </h1>
      <p class="text-zinc-500 mt-3.5 text-sm sm:text-base font-medium">
        MozJPEG, LibWebP & on-device AI — free, instant, zero uploads.
      </p>
    </div>

    <ToolWorkspace client:load initialMode="converter" showModeTabs={true} />
  </section>

  <!-- Studio Tools Bento Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-950">Dedicated Tools</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {studioTools.map((tool) => (
        <a
          href={tool.href}
          class="group studio-card rounded-2xl p-5 hover:-translate-y-0.5 hover:border-blue-500/40 transition-all duration-200 flex flex-col justify-between gap-5"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 flex items-center justify-center transition-colors">
              {tool.icon === 'sparkles' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                </svg>
              )}
              {tool.icon === 'crop' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2v14a2 2 0 0 0 2 2h14" />
                  <path d="M18 22V8a2 2 0 0 0-2-2H2" />
                </svg>
              )}
              {tool.icon === 'sliders' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="21" x2="14" y1="4" y2="4" />
                  <line x1="10" x2="3" y1="4" y2="4" />
                  <line x1="21" x2="12" y1="12" y2="12" />
                  <line x1="8" x2="3" y1="12" y2="12" />
                  <line x1="21" x2="16" y1="20" y2="20" />
                  <line x1="12" x2="3" y1="20" y2="20" />
                  <circle cx="12" cy="4" r="2" />
                  <circle cx="10" cy="12" r="2" />
                  <circle cx="14" cy="20" r="2" />
                </svg>
              )}
              {tool.icon === 'file' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                  <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                  <path d="M10 13H8" />
                  <path d="M16 17H8" />
                </svg>
              )}
              {tool.icon === 'stamp' && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 22h14" />
                  <path d="M19.27 13.73A2.5 2.5 0 0 0 17.5 13h-11A2.5 2.5 0 0 0 4 15.5V17a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-1.5c0-.66-.26-1.3-.73-1.77Z" />
                  <path d="M14 13V8.5C14 7 15 7 15 5a3 3 0 0 0-3-3c-1.66 0-3 1-3 3s1 2 1 3.5V13" />
                </svg>
              )}
            </div>

            <span class="px-2.5 py-1 rounded-lg bg-zinc-100 text-zinc-600 text-[11px] font-semibold">
              {tool.tag}
            </span>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-bold text-zinc-950 text-[15.5px] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                {tool.title}
              </h3>
              <svg class="w-4 h-4 text-zinc-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </div>
            <p class="text-xs sm:text-[13px] text-zinc-500 mt-1">{tool.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Minimal Quick Presets Index -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 mb-6">Quick Presets</h2>

    <div class="studio-card rounded-3xl p-6 sm:p-7 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.map((cat) => (
        <div>
          <h3 class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 mb-3">
            {cat}
          </h3>
          <div class="flex flex-col gap-1">
            {SEO_PAGES.filter((p) => p.category === cat).map((page) => (
              <a
                href={`/${page.slug}`}
                class="group flex items-center justify-between py-1.5 px-2.5 -mx-2.5 rounded-xl text-[13px] font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950 transition"
              >
                <span>{page.shortName}</span>
                <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-60 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Architectural Spec Strip -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-4">
    <div class="grid sm:grid-cols-3 gap-6 border-t border-zinc-200/80 pt-10">
      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="16" x="4" y="4" rx="2" />
            <rect width="6" height="6" x="9" y="9" rx="1" />
            <path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">WebAssembly Codecs</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Real MozJPEG, LibWebP & UPNG encoders running in background threads.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">Zero Server Uploads</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Private photos, signatures & documents never leave your device.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200/80 text-zinc-800 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-zinc-950">Instant Batch & ZIP</h3>
          <p class="text-xs text-zinc-500 mt-1 leading-relaxed">
            Process up to 20 images at once with split-screen quality compare.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
