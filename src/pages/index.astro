---
import Layout from '../layouts/Layout.astro';
import ToolWorkspace from '../components/ToolWorkspace';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ImageLab Free Online Image Tools',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Free, fast, and 100% private browser-based image converter, compressor, resizer, and enhancer with batch ZIP download.',
};
---

<Layout
  title="ImageLab — Free Online Image Converter, Compressor & Resizer (No Upload)"
  description="Convert JPG, PNG, WEBP, compress photos to exact KB, resize for jobs & social media, and enhance images directly in your browser. 100% free & private."
  schemas={[homeSchema]}
>
  <section class="max-w-4xl mx-auto px-4 pt-8 sm:pt-12 pb-6">
    <!-- Hero Header -->
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
        All-in-One Free Image Tools
      </h1>
      <p class="text-slate-600 mt-3 text-sm sm:text-base">
        Convert, compress to exact KB, resize, and enhance photos directly on your device—no login, no limits, zero server uploads.
      </p>
    </div>

    <!-- Interactive Workspace (Loads Immediately) -->
    <ToolWorkspace client:load initialMode="converter" showModeTabs={true} />
  </section>

  <!-- Why Choose ImageLab -->
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-center text-slate-900 mb-8">
      Why Users Trust ImageLab
    </h2>
    <div class="grid sm:grid-cols-3 gap-5">
      <div class="bg-white p-6 rounded-2xl border border-slate-200">
        <div class="text-2xl mb-2">🔒</div>
        <h3 class="font-bold text-slate-900">100% Private</h3>
        <p class="text-sm text-slate-600 mt-1">
          Every photo is processed right inside your browser. We never upload, store, or see your files.
        </p>
      </div>
      <div class="bg-white p-6 rounded-2xl border border-slate-200">
        <div class="text-2xl mb-2">⚡</div>
        <h3 class="font-bold text-slate-900">Batch & Target KB</h3>
        <p class="text-sm text-slate-600 mt-1">
          Process up to 20 images at once, hit exact 50KB/100KB form limits, and grab a single ZIP.
        </p>
      </div>
      <div class="bg-white p-6 rounded-2xl border border-slate-200">
        <div class="text-2xl mb-2">💎</div>
        <h3 class="font-bold text-slate-900">Free Forever</h3>
        <p class="text-sm text-slate-600 mt-1">
          No watermarks, no forced signup, and works smoothly on both mobile phones and desktops.
        </p>
      </div>
    </div>
  </section>
</Layout>
